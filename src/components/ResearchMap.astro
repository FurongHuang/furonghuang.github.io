---
import { researchPillars } from "../data/site";
---

<div class="research-map" aria-label="Three connected research pillars">
  <svg class="research-map-lines" viewBox="0 0 1000 360" aria-hidden="true">
    <defs>
      <linearGradient id="flow" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#27a4a2" />
        <stop offset="0.5" stop-color="#f08a72" />
        <stop offset="1" stop-color="#7c6fd0" />
      </linearGradient>
    </defs>
    <path d="M140 185 C280 40 380 40 500 180 S720 320 860 175" />
    <path class="flow-line" d="M140 185 C280 40 380 40 500 180 S720 320 860 175" />
  </svg>
  {researchPillars.map((pillar, index) => (
    <article class={`research-node node-${index + 1}`}>
      <div class="node-orbit" aria-hidden="true"><span></span></div>
      <p class="eyebrow">Pillar {pillar.number}</p>
      <h3>{pillar.title}</h3>
      <strong>{pillar.subtitle}</strong>
      <p>{pillar.description}</p>
      <ul>
        {pillar.topics.map((topic) => <li>{topic}</li>)}
      </ul>
    </article>
  ))}
</div>
