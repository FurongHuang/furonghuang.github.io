---
import { socialLinks } from "../data/site";

const { compact = false } = Astro.props as { compact?: boolean };
---

<div class:list={["social-links", { compact }]} aria-label="Furong Huang on other platforms">
  {socialLinks.map((link) => (
    <a href={link.href} target="_blank" rel="me noopener" aria-label={link.label} title={link.label}>
      {link.id === "scholar" && (
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 1.8 8.5 12 14l8-4.3V16h2V8.5L12 3Zm-6 9v4.8C7.5 19 9.5 20 12 20s4.5-1 6-3.2V12l-6 3.2L6 12Z" /></svg>
      )}
      {link.id === "x" && (
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.9 2H22l-6.8 7.8L23.2 22H17l-4.9-6.4L6.5 22H3.4l7.2-8.3L.8 2h6.4l4.4 5.8L18.9 2Zm-1.1 17.9h1.7L6.3 4H4.5l13.3 15.9Z" /></svg>
      )}
      {link.id === "linkedin" && (
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.3 7.9A2.3 2.3 0 1 0 5.3 3.3a2.3 2.3 0 0 0 0 4.6ZM3.4 21h3.8V9.2H3.4V21Zm6.1 0h3.8v-6.5c0-1.7.3-3.3 2.4-3.3 2 0 2 1.9 2 3.4V21h3.8v-7.2c0-3.5-.8-6.2-4.9-6.2-2 0-3.3 1.1-3.8 2.1h-.1V9.2H9.5V21Z" /></svg>
      )}
      {link.id === "github" && (
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.2 19.5v-2.2c-2.6.6-3.1-1.1-3.1-1.1-.4-1.1-1.1-1.4-1.1-1.4-.9-.6.1-.6.1-.6 1 0 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.8.8.1-.7.4-1.1.6-1.3-2.1-.2-4.3-1-4.3-4.6 0-1 .4-1.8 1-2.5-.1-.2-.4-1.2.1-2.5 0 0 .8-.3 2.7 1A9.4 9.4 0 0 1 12 7.8c.8 0 1.6.1 2.4.3 1.9-1.3 2.7-1 2.7-1 .5 1.3.2 2.3.1 2.5.6.7 1 1.5 1 2.5 0 3.6-2.2 4.4-4.3 4.6.4.3.7.9.7 1.7v3.1A10 10 0 0 0 12 2Z" /></svg>
      )}
      {link.id === "huggingface" && <span class="hf-mark" aria-hidden="true">HF</span>}
      {!compact && <span>{link.label}</span>}
    </a>
  ))}
</div>
