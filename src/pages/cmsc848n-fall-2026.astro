<script>
  type ProjectCandidate = {
    number: string;
    orientation: "Research-oriented" | "Engineering-oriented";
    track: string;
    title: string;
    challenge: string;
    motivation?: string;
    question: string;
    hypothesis: string;
    example?: string;
    firstSteps?: string;
    pitfalls?: string;
    evidence: string;
    personalize: string;
    skills: string[];
    startingPoints: [string, string, string?][];
  };

  type EncryptedCatalog = {
    version: number;
    kdf: "PBKDF2";
    hash: "SHA-256";
    iterations: number;
    cipher: "AES-GCM";
    salt: string;
    iv: string;
    aad: string;
    ciphertext: string;
  };

  const lock = document.querySelector<HTMLElement>("[data-catalog-lock]");
  const form = document.querySelector<HTMLFormElement>("[data-catalog-form]");
  const passwordInput = document.querySelector<HTMLInputElement>("[data-catalog-password]");
  const submitButton = document.querySelector<HTMLButtonElement>("[data-catalog-submit]");
  const status = document.querySelector<HTMLElement>("[data-catalog-status]");
  const catalogShell = document.querySelector<HTMLElement>("[data-catalog-shell]");
  const catalog = document.querySelector<HTMLElement>("[data-project-catalog]");
  const relockButton = document.querySelector<HTMLButtonElement>("[data-catalog-relock]");

  if (lock && form && passwordInput && submitButton && status && catalogShell && catalog && relockButton) {
    const encoder = new TextEncoder();
    const decoder = new TextDecoder();
    let encryptedCatalog: Promise<EncryptedCatalog> | null = null;

    const fromBase64 = (value: string) => {
      const decoded = atob(value);
      return Uint8Array.from(decoded, (character) => character.charCodeAt(0));
    };

    const loadEncryptedCatalog = () => {
      if (!encryptedCatalog) {
        const url = lock.dataset.catalogUrl;
        if (!url) throw new Error("Missing catalogue URL");
        encryptedCatalog = fetch(url, { cache: "no-store" }).then(async (response) => {
          if (!response.ok) throw new Error("Catalogue unavailable");
          return response.json() as Promise<EncryptedCatalog>;
        });
      }
      return encryptedCatalog;
    };

    const textElement = <K extends keyof HTMLElementTagNameMap>(tag: K, text: string, className?: string) => {
      const element = document.createElement(tag);
      element.textContent = text;
      if (className) element.className = className;
      return element;
    };

    const addBriefField = (list: HTMLDListElement, label: string, value: string) => {
      const row = document.createElement("div");
      row.append(textElement("dt", label), textElement("dd", value));
      list.append(row);
    };

    type ProjectGroup = { id: string; title: string; description: string; projects: string[] };

    const renderCatalog = (projects: ProjectCandidate[], guidance?: string, groups: ProjectGroup[] = [], researchGuidance?: string) => {
      const fragment = document.createDocumentFragment();
      if (guidance) fragment.append(textElement("p", guidance, "catalog-guidance"));
      if (researchGuidance) {
        const advice = document.createElement("details");
        advice.className = "catalog-guidance";
        advice.append(textElement("summary", "Planning a sound experiment"), textElement("p", researchGuidance));
        fragment.append(advice);
      }
      const byNumber = new Map(projects.map(project => [project.number, project]));
      const ordered: ProjectCandidate[] = [];
      const seen = new Set<string>();
      const headings = new Map<string, ProjectGroup>();
      const navigation = document.createElement("nav");
      navigation.className = "catalog-guidance catalog-theme-links";
      navigation.setAttribute("aria-label", "Project themes");
      groups.forEach((group, index) => {
        const members = group.projects.filter(number => byNumber.has(number) && !seen.has(number));
        if (!members.length) return;
        const safeGroup = { ...group, id: `catalog-theme-${index + 1}` };
        headings.set(members[0], safeGroup);
        const link = textElement("a", `${group.title} (${members.length})`);
        link.href = `#${safeGroup.id}`;
        navigation.append(link);
        members.forEach(number => { seen.add(number); ordered.push(byNumber.get(number)!); });
      });
      if (navigation.childElementCount) fragment.append(navigation);
      ordered.push(...projects.filter(project => !seen.has(project.number)));

      ordered.forEach((project) => {
        const group = headings.get(project.number);
        if (group) {
          const heading = document.createElement("div");
          heading.className = "catalog-theme-heading";
          heading.id = group.id;
          heading.append(textElement("h3", group.title), textElement("p", group.description));
          fragment.append(heading);
        }
        const card = document.createElement("details");
        card.className = "project-card";

        const summary = document.createElement("summary");
        const meta = document.createElement("div");
        meta.className = "project-card-meta";
        meta.append(textElement("span", project.number), textElement("small", project.track));
        summary.append(
          meta,
          textElement("p", project.orientation, "project-orientation"),
          textElement("h4", project.title),
          textElement("p", project.challenge),
          textElement("span", "Open project brief", "project-open-label")
        );

        const body = document.createElement("div");
        body.className = "project-card-body";
        const fields = document.createElement("dl");
        if (project.example) addBriefField(fields, "Consider this example", project.example);
        if (project.motivation) addBriefField(fields, "What you will investigate", project.motivation);
        addBriefField(fields, "The central question", project.question);
        addBriefField(fields, "An idea to test", project.hypothesis);
        if (project.firstSteps) addBriefField(fields, "Your first experiment", project.firstSteps);
        addBriefField(fields, "What would count as convincing evidence?", project.evidence);
        if (project.pitfalls) addBriefField(fields, "Where to be careful", project.pitfalls);
        addBriefField(fields, "Choosing your scope", project.personalize);

        const skills = document.createElement("div");
        skills.className = "project-skills";
        skills.setAttribute("aria-label", "Useful preparation");
        project.skills.forEach((skill) => skills.append(textElement("span", skill)));

        const reading = document.createElement("div");
        reading.className = "project-reading";
        reading.append(textElement("strong", "Readings and resources"));
        const readingList = document.createElement("ol");
        project.startingPoints.forEach(([label, url, note]) => {
          const parsedUrl = new URL(url);
          if (parsedUrl.protocol !== "https:" && parsedUrl.protocol !== "http:") return;
          const link = textElement("a", `${label} ↗`);
          link.href = parsedUrl.href;
          link.target = "_blank";
          link.rel = "noopener noreferrer";
          const item = document.createElement("li");
          item.append(link);
          if (note) item.append(textElement("p", note));
          readingList.append(item);
        });
        reading.append(readingList);

        body.append(fields, skills, reading);
        card.append(summary, body);
        fragment.append(card);
      });

      catalog.replaceChildren(fragment);
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const password = passwordInput.value;
      if (!password || !window.crypto?.subtle) {
        status.textContent = window.crypto?.subtle
          ? "Enter the course password."
          : "This browser cannot decrypt the catalogue. Please use a current browser.";
        return;
      }

      submitButton.disabled = true;
      submitButton.textContent = "Unlocking…";
      status.textContent = "Checking password…";
      let loaded = false;

      try {
        const payload = await loadEncryptedCatalog();
        loaded = true;
        if (
          payload.version !== 1 ||
          payload.kdf !== "PBKDF2" ||
          payload.hash !== "SHA-256" ||
          payload.cipher !== "AES-GCM" ||
          payload.iterations < 100000 ||
          payload.iterations > 1000000
        ) throw new Error("Unsupported catalogue format");

        const keyMaterial = await crypto.subtle.importKey(
          "raw",
          encoder.encode(password),
          "PBKDF2",
          false,
          ["deriveKey"]
        );
        const key = await crypto.subtle.deriveKey(
          {
            name: "PBKDF2",
            salt: fromBase64(payload.salt),
            iterations: payload.iterations,
            hash: payload.hash
          },
          keyMaterial,
          { name: "AES-GCM", length: 256 },
          false,
          ["decrypt"]
        );
        const plaintext = await crypto.subtle.decrypt(
          {
            name: "AES-GCM",
            iv: fromBase64(payload.iv),
            additionalData: encoder.encode(payload.aad)
          },
          key,
          fromBase64(payload.ciphertext)
        );
        const decrypted = JSON.parse(decoder.decode(plaintext)) as { projects?: ProjectCandidate[]; guidance?: string; groups?: ProjectGroup[]; researchGuidance?: string };
        if (!Array.isArray(decrypted.projects) || decrypted.projects.length === 0) {
          throw new Error("Invalid catalogue");
        }

        renderCatalog(decrypted.projects, decrypted.guidance, decrypted.groups, decrypted.researchGuidance);
        passwordInput.value = "";
        lock.hidden = true;
        catalogShell.hidden = false;
        status.textContent = "Catalogue unlocked.";
        requestAnimationFrame(() => catalog.querySelector("summary")?.focus());
      } catch {
        status.textContent = loaded
          ? "That password did not unlock the catalogue. Please try again."
          : "The encrypted catalogue is temporarily unavailable. Please try again.";
        passwordInput.select();
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = "Unlock";
      }
    });

    relockButton.addEventListener("click", () => {
      catalog.replaceChildren();
      catalogShell.hidden = true;
      lock.hidden = false;
      status.textContent = "Password is checked in this browser and is never submitted.";
      requestAnimationFrame(() => passwordInput.focus());
    });
  }
</script>

