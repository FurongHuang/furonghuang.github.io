---
interface Link {
  label?: string;
  url?: string;
}

interface Paper {
  id: string;
  title: string;
  authors: string[];
  year: number | null;
  category: string;
  venue: string;
  links: Link[];
  flags?: string[];
}

const { paper, compact = false } = Astro.props as { paper: Paper; compact?: boolean };
const inferLabel = (label: string | undefined, url: string) => {
  const cleanLabel = label?.trim();
  if (cleanLabel) return cleanLabel;
  if (/arxiv\.org/i.test(url)) return "arXiv";
  if (/openreview\.net/i.test(url)) return "OpenReview";
  if (/github\.com/i.test(url)) return "Code";
  if (/doi\.org/i.test(url)) return "DOI";
  if (/youtu\.be|youtube\.com/i.test(url)) return "Video";
  if (/\.pdf(?:$|\?)/i.test(url)) return "PDF";
  return "Project";
};

const cleanLinks = Array.from(
  new Map(
    (paper.links || [])
      .map((link) => link.url?.trim().replace(/[\"']+$/, "") || "")
      .map((url, index) => ({ label: inferLabel(paper.links[index]?.label, url), url }))
      .filter((link) => /^https?:\/\//.test(link.url))
      .map((link) => [link.url, link])
  ).values()
).slice(0, 4);

const authorText = (paper.authors || []).join(", ");
const authorMarkup = authorText.replace(/Furong Huang/g, "<strong>Furong Huang</strong>");
const accent = paper.category === "journal" ? "coral" : paper.category === "workshop" ? "violet" : "teal";
const venue = paper.venue?.trim().replace(/^,\s*/, "") || "";
---

<article class:list={["paper-card", `accent-${accent}`, { compact }]} data-paper data-year={paper.year || ""} data-category={paper.category} data-search={`${paper.title} ${authorText} ${paper.venue}`.toLowerCase()}>
  <div class="paper-visual" aria-hidden="true">
    <span>{String(paper.year || "—").slice(-2)}</span>
    <i></i><i></i><i></i>
  </div>
  <div class="paper-body">
    <div class="paper-meta">
      <span>{paper.category || "publication"}</span>
      <span>{paper.year || "Forthcoming"}</span>
    </div>
    <h3>{paper.title}</h3>
    <p class="paper-authors" set:html={authorMarkup}></p>
    {venue && venue !== String(paper.year) && <p class="paper-venue">{venue}</p>}
    {cleanLinks.length > 0 && (
      <div class="paper-links">
        {cleanLinks.map((link) => <a href={link.url}>{link.label}<span>↗</span></a>)}
      </div>
    )}
  </div>
</article>
