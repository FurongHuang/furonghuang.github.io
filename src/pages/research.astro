---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResearchMap from "../components/ResearchMap.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects, researchPillars } from "../data/site";

const featuredAreas = {
  "world-models": {
    title: "Embodied AI",
    description: "World models become tangible when agents must understand space, bodies, state, and consequences. Explore representative systems, videos, code, and papers.",
    href: "/research/embodied-ai/"
  },
  "reasoning-control": {
    title: "AI Agents",
    description: "Agents turn reasoning into purposeful behavior by planning, using tools, verifying progress, and recovering when an initial strategy fails.",
    href: "/research/ai-agents/"
  },
  "self-improvement": {
    title: "AI Safety",
    description: "Adaptive attacks, agentic evaluations, and stress tests expose latent failures so models can be corrected before unsafe behavior reaches deployment.",
    href: "/research/ai-safety/"
  }
} as const;
---

<BaseLayout title="Research — Furong Lab">
  <section class="shell page-hero">
    <p class="eyebrow">Research program</p>
    <h1>Foundation models as decision-making systems.</h1>
    <p>
      Furong Lab studies models that allocate computation, choose tools and collaborators, act in physical environments, and revise behavior after failure. Select any pillar or topic to follow the work from research question to project and paper.
    </p>
  </section>

  <section class="shell section" style="padding-top: 1rem">
    <ResearchMap />
  </section>

  {researchPillars.map((pillar) => (
    <section class={`pillar-section pillar-section-${pillar.id}`} id={pillar.id}>
      <div class="shell pillar-section-inner">
        <div class="pillar-intro">
          <p class="eyebrow">Pillar {pillar.number}</p>
          <h2>{pillar.title}</h2>
          <strong>{pillar.subtitle}</strong>
          <p>{pillar.description}</p>
          <div class="topic-links">
            {pillar.topics.map((topic) => <a href={topic.href}>{topic.label}<span>→</span></a>)}
          </div>
        </div>
        <div class="pillar-feature">
          <p class="eyebrow">Featured area</p>
          <h3>{featuredAreas[pillar.id].title}</h3>
          <p>{featuredAreas[pillar.id].description}</p>
          <a class="button" href={featuredAreas[pillar.id].href}>Explore {featuredAreas[pillar.id].title} <span>→</span></a>
        </div>
      </div>
    </section>
  ))}

  <section class="shell section">
    <div class="section-heading">
      <div><p class="eyebrow">Representative projects</p><h2>Ideas you can inspect and use.</h2></div>
      <p>Project pages bring together papers, code, demonstrations, and the visual evidence behind the research.</p>
    </div>
    <div class="project-grid">
      {projects.slice(0, 2).map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</BaseLayout>
