---
type LabPhoto = {
  src: string;
  alt: string;
  theme: string;
  caption: string;
  width: number;
  height: number;
};

type LabLocation = {
  building: string;
  room: string;
  access: string;
};

type Props = {
  photos?: LabPhoto[];
  eyebrow?: string;
  heading?: string;
  description?: string;
  sectionId?: string;
  locations?: LabLocation[];
};

const defaultPhotos: LabPhoto[] = [
  { src: "/assets/people/furong-lab-group.jpg", alt: "Furong Huang with members of Furong Lab outside a University of Maryland building", theme: "Furong Lab", caption: "The lab at the University of Maryland", width: 2400, height: 1625 },
  { src: "/assets/people/lab-gallery/lab-outdoors.webp", alt: "Members of Furong Lab gathered outdoors at dusk", theme: "Community", caption: "An evening with Furong Lab", width: 1600, height: 1200 },
  { src: "/assets/people/lab-gallery/lab-selfie.webp", alt: "Furong Lab members taking a group selfie outdoors", theme: "Community", caption: "A candid lab moment", width: 1600, height: 1200 },
  { src: "/assets/people/lab-gallery/group-dinner.webp", alt: "Furong Lab members gathered around a table for dinner", theme: "Community", caption: "Ideas and conversation around the table", width: 1600, height: 1200 },
  { src: "/assets/people/lab-gallery/new-semester-dinner.png", alt: "Furong Lab members gathered for dinner at the beginning of a new semester", theme: "Community", caption: "A new semester begins", width: 1200, height: 874 },
  { src: "/assets/people/lab-gallery/lab-dinner-portrait.jpg", alt: "Furong Huang and members of Furong Lab seated together at dinner", theme: "Community", caption: "Around the table with Furong Lab", width: 1200, height: 1600 },
  { src: "/assets/people/lab-gallery/lab-lunch.webp", alt: "Furong Lab members gathered for a meal", theme: "Community", caption: "Time together beyond the lab", width: 1600, height: 1200 },
  { src: "/assets/people/lab-gallery/lab-table.webp", alt: "Members of Furong Lab seated together at a restaurant", theme: "Community", caption: "A lab gathering", width: 1600, height: 1200 },
  { src: "/assets/people/lab-gallery/team-dinner.webp", alt: "Furong Lab members smiling together at dinner", theme: "Community", caption: "Furong Lab together", width: 675, height: 1200 },
  { src: "/assets/people/lab-gallery/group-on-the-road.webp", alt: "Furong Huang and lab members traveling together", theme: "Community", caption: "The lab on the road", width: 1550, height: 1200 },
  { src: "/assets/people/lab-gallery/research-panel.webp", alt: "Furong Huang and fellow panelists speaking at a research event", theme: "Research in action", caption: "Sharing ideas with the broader research community", width: 1600, height: 1200 },
  { src: "/assets/people/lab-gallery/poster-session-one.webp", alt: "A Furong Lab researcher presenting a poster at a conference", theme: "Research in action", caption: "Presenting new work", width: 900, height: 1200 },
  { src: "/assets/people/lab-gallery/poster-session-two.webp", alt: "Furong Lab researchers discussing a poster at a conference", theme: "Research in action", caption: "Research conversations at a poster session", width: 900, height: 1200 },
  { src: "/assets/people/lab-gallery/evening-gathering.webp", alt: "Furong Lab members gathered for an evening meal", theme: "Community", caption: "Celebrating the people behind the research", width: 900, height: 1200 },
  { src: "/assets/people/lab-gallery/graduation-celebration.webp", alt: "Furong Huang celebrating with a graduate at University of Maryland commencement", theme: "Milestones", caption: "Celebrating graduation", width: 1173, height: 788 },
  { src: "/assets/people/lab-gallery/graduation-day.webp", alt: "Furong Huang with graduates at University of Maryland commencement", theme: "Milestones", caption: "Graduation day at Maryland", width: 1600, height: 1200 },
  { src: "/assets/people/lab-gallery/commencement-memory-one.png", alt: "Furong Huang and a Furong Lab graduate seated at University of Maryland commencement", theme: "Milestones", caption: "Commencement memories", width: 1200, height: 861 },
  { src: "/assets/people/lab-gallery/commencement-memory-two.png", alt: "Furong Lab graduates seated together at University of Maryland commencement", theme: "Milestones", caption: "Celebrating the class of 2026", width: 1008, height: 796 },
  { src: "/assets/people/lab-gallery/research-milestone.png", alt: "Furong Huang celebrating a Furong Lab graduate at UMIACS", theme: "Milestones", caption: "Celebrating a research milestone", width: 1200, height: 887 }
];

const {
  photos = defaultPhotos,
  eyebrow = "Life in Furong Lab",
  heading = "Milestones, ideas, and time together.",
  description = "From presenting new work to graduations and shared meals—the lab is a community as much as a research group.",
  sectionId = "lab-moments",
  locations = []
} = Astro.props as Props;
---

<section class="shell section lab-moments" id={sectionId} aria-labelledby={`${sectionId}-title`}>
  <div class="lab-moments-heading">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h2 id={`${sectionId}-title`}>{heading}</h2>
    </div>
    <div class="lab-moments-copy">
      <p>{description}</p>
      {locations.length > 0 && (
        <div class="lab-location-list" aria-label="Furong Lab locations">
          {locations.map((location) => (
            <span>
              <strong>{location.building}</strong> {location.room}
              <small>· {location.access}</small>
            </span>
          ))}
        </div>
      )}
    </div>
  </div>

  <div class="lab-carousel" data-lab-carousel>
    <div class="lab-carousel-controls">
      <p aria-live="polite"><span data-current>1</span> / {photos.length}</p>
      <button type="button" data-previous aria-label="Show previous lab photo">←</button>
      <button type="button" data-next aria-label="Show next lab photo">→</button>
    </div>

    <div class="lab-carousel-track" data-track tabindex="0" aria-label="Furong Lab photo gallery">
      {photos.map((photo, index) => (
        <figure
          class:list={["lab-carousel-slide", photo.height > photo.width ? "is-portrait" : "is-landscape"]}
          data-slide
          aria-label={`Photo ${index + 1} of ${photos.length}`}
        >
          <div class="lab-carousel-image" style={`--image-aspect: ${photo.width} / ${photo.height}`}>
            <img
              src={photo.src}
              alt={photo.alt}
              width={photo.width}
              height={photo.height}
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption><span>{photo.theme}</span><strong>{photo.caption}</strong></figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-lab-carousel]").forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>("[data-track]");
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>("[data-slide]"));
    const previous = carousel.querySelector<HTMLButtonElement>("[data-previous]");
    const next = carousel.querySelector<HTMLButtonElement>("[data-next]");
    const current = carousel.querySelector<HTMLElement>("[data-current]");
    if (!track || !slides.length || !previous || !next || !current) return;

    let activeIndex = 0;
    let frame = 0;

    const update = () => {
      const trackLeft = track.getBoundingClientRect().left;
      activeIndex = slides.reduce((best, slide, index) => {
        const distance = Math.abs(slide.getBoundingClientRect().left - trackLeft);
        const bestDistance = Math.abs(slides[best].getBoundingClientRect().left - trackLeft);
        return distance < bestDistance ? index : best;
      }, 0);
      current.textContent = String(activeIndex + 1);
      previous.disabled = activeIndex === 0;
      next.disabled = activeIndex === slides.length - 1;
    };

    const show = (index: number) => {
      const target = slides[Math.max(0, Math.min(index, slides.length - 1))];
      track.scrollTo({ left: target.offsetLeft - track.offsetLeft, behavior: "smooth" });
    };

    previous.addEventListener("click", () => show(activeIndex - 1));
    next.addEventListener("click", () => show(activeIndex + 1));
    track.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        show(activeIndex - 1);
      }
      if (event.key === "ArrowRight") {
        event.preventDefault();
        show(activeIndex + 1);
      }
    });
    track.addEventListener("scroll", () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(update);
    }, { passive: true });
    update();
  });
</script>

<style>
  .lab-moments {
    padding-top: 2.5rem;
  }

  .lab-moments-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
    gap: 2rem;
    align-items: end;
    margin-bottom: 1.6rem;
  }

  .lab-moments-heading h2 {
    max-width: 12ch;
    margin: 0.35rem 0 0;
  }

  .lab-moments-copy > p {
    max-width: 38rem;
    margin: 0;
    color: var(--ink-soft);
  }

  .lab-location-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1rem;
  }

  .lab-location-list span {
    padding: 0.55rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--teal) 30%, var(--line));
    border-radius: 999px;
    color: var(--ink-soft);
    background: color-mix(in srgb, var(--teal) 7%, var(--paper));
    font-size: 0.75rem;
  }

  .lab-location-list strong {
    color: var(--teal-dark);
    letter-spacing: 0.06em;
  }

  .lab-location-list small {
    margin-left: 0.45rem;
    padding-left: 0.45rem;
    border-left: 1px solid color-mix(in srgb, var(--teal) 25%, var(--line));
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 700;
  }

  .lab-carousel {
    position: relative;
    padding: 1rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 28px;
    background: color-mix(in srgb, var(--paper) 88%, white);
  }

  .lab-carousel-controls {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 0.75rem;
  }

  .lab-carousel-controls p {
    min-width: 4.2rem;
    margin: 0 0.45rem 0 0;
    color: var(--ink-soft);
    font-size: 0.78rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-align: right;
  }

  .lab-carousel-controls button {
    display: inline-grid;
    width: 2.7rem;
    height: 2.7rem;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--paper);
    color: var(--navy);
    font: inherit;
    font-size: 1.15rem;
    cursor: pointer;
    transition: transform 160ms ease, background 160ms ease, opacity 160ms ease;
  }

  .lab-carousel-controls button:hover:not(:disabled) {
    transform: translateY(-2px);
    background: white;
  }

  .lab-carousel-controls button:focus-visible,
  .lab-carousel-track:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--teal) 45%, transparent);
    outline-offset: 3px;
  }

  .lab-carousel-controls button:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .lab-carousel-track {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-behavior: smooth;
    scroll-snap-type: inline mandatory;
    scrollbar-width: none;
  }

  .lab-carousel-track::-webkit-scrollbar {
    display: none;
  }

  .lab-carousel-slide {
    flex: 0 0 auto;
    width: min(76vw, 44rem);
    margin: 0;
    overflow: hidden;
    scroll-snap-align: start;
    border-radius: 20px;
    background: white;
    box-shadow: 0 12px 30px rgba(14, 39, 61, 0.08);
  }

  .lab-carousel-slide.is-portrait {
    width: min(48vw, 20rem);
  }

  .lab-carousel-image {
    display: grid;
    aspect-ratio: var(--image-aspect);
    place-items: center;
    overflow: hidden;
    background: #142d45;
  }

  .lab-carousel-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lab-carousel-slide figcaption {
    display: grid;
    min-height: 4.7rem;
    gap: 0.25rem;
    padding: 1rem 1.2rem;
  }

  .lab-carousel-slide figcaption span {
    color: var(--teal);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .lab-carousel-slide figcaption strong {
    color: var(--navy);
    font-weight: 700;
  }

  @media (max-width: 760px) {
    .lab-moments {
      padding-top: 1.5rem;
    }

    .lab-moments-heading {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }

    .lab-moments-heading h2 {
      max-width: 14ch;
    }

    .lab-carousel {
      padding: 0.7rem;
      border-radius: 22px;
    }

    .lab-carousel-controls {
      margin-right: 0.2rem;
    }

    .lab-carousel-slide {
      width: 94%;
      border-radius: 16px;
    }

    .lab-carousel-slide.is-portrait {
      width: 72%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lab-carousel-track {
      scroll-behavior: auto;
    }

    .lab-carousel-controls button {
      transition: none;
    }
  }
</style>
