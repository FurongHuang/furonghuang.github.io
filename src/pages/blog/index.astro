---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { blogPosts } from "../../data/site";
import { blogSocialImages, defaultBlogSocialImage } from "../../data/blog-social-images";
---

<BaseLayout title="Blog — Furong Lab" description="Essays and lab notes from Furong Huang and Furong Lab at UMD.">
  <section class="shell page-hero">
    <p class="eyebrow">Notes from the work</p>
    <h1>Blog</h1>
    <p>Research stories, lessons from building the academic community, and context that does not fit inside a paper abstract.</p>
    <a class="text-link" href="/blog/citations.bib" download>Download all blog citations <span aria-hidden="true">↓</span></a>
  </section>
  <section class="shell section" style="padding-top: 0">
    <div class="blog-grid">
      {blogPosts.map((post, index) => {
        const artwork = blogSocialImages[post.slug] || defaultBlogSocialImage;
        const thumbnail = artwork.image
          .replace("/assets/blog/", "/assets/blog/thumbnails/")
          .replace(/\.png$/, "");
        return (
          <article class:list={["blog-card", { featured: index === 0 }]}>
            <a class="blog-card-artwork" href={`/blog/${post.slug}/`} aria-label={`Read ${post.title}`}>
              <img
                src={`${thumbnail}-1200.webp`}
                srcset={`${thumbnail}-640.webp 640w, ${thumbnail}-1200.webp 1200w`}
                sizes="(max-width: 560px) calc(100vw - 2rem), (max-width: 800px) calc(100vw - 3rem), (max-width: 1288px) calc((100vw - 4.25rem) / 2), 610px"
                width="1200"
                height="630"
                alt={artwork.alt}
                loading={index < 2 ? "eager" : "lazy"}
                fetchpriority={index === 0 ? "high" : "auto"}
                decoding="async"
              />
            </a>
            <div class="blog-card-content">
              <time>{post.date}</time>
              <h2><a href={`/blog/${post.slug}/`}>{post.title}</a></h2>
              <p>{post.excerpt}</p>
              <div class="blog-tags">{post.tags.map((tag) => <span>{tag}</span>)}</div>
              <a class="text-link" href={`/blog/${post.slug}/`}>Read the story <span aria-hidden="true">→</span></a>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>
