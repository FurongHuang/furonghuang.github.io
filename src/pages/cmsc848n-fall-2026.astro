    gap: 5rem;
    align-items: end;
    min-height: 680px;
    padding-block: 7rem 4rem;
  }

  .course-hero h1,
  .course-section-heading h2,
  .course-final-cta h2 {
    margin: 0;
    font-family: "Newsreader", serif;
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.05em;
  }

  .course-hero h1 { font-size: clamp(4.6rem, 9vw, 8.5rem); }
  .course-hero h1 em { color: var(--teal); font-style: normal; }

  .course-lede {
    max-width: 720px;
    margin: 2rem 0;
    color: var(--ink-soft);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
  }

  .course-at-a-glance {
    padding: 2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow);
  }

  .course-at-a-glance > div {
    display: flex;
    align-items: baseline;
