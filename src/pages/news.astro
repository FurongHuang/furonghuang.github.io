---
import BaseLayout from "../layouts/BaseLayout.astro";
import { news } from "../data/site";
---

<BaseLayout title="News — Furong Lab" description="Research, talks, awards, publications, and people news from Furong Lab at UMD.">
  <section class="shell page-hero">
    <p class="eyebrow">Lab notebook</p>
    <h1>News</h1>
    <p>Research releases, talks, student milestones, awards, and other signals from Furong Lab.</p>
  </section>
  <section class="shell section" style="padding-top: 0">
    <div class="news-list">
      {news.map((item) => (
        <article>
          <time>{item.date}</time>
          <span class="news-type">{item.type}</span>
          <div><h2>{item.title}</h2><p>{item.detail}</p></div>
          {"links" in item && item.links ? (
            <div class="news-actions">
              {item.links.map((link) => <a href={link.href}>{link.label} <span>↗</span></a>)}
            </div>
          ) : item.href ? <a href={item.href}>Open <span>↗</span></a> : <span></span>}
        </article>
      ))}
    </div>
    <p class="archive-note">Research releases, invited talks, recognition, career milestones, public engagement, and academic service.</p>
  </section>
</BaseLayout>
