---
import BaseLayout from "../layouts/BaseLayout.astro";

const slideRoot = "/courses/cmsc848n/fall-2026/slides";

// Add a filename here only when its approved deck is copied into slideRoot.
// Course policy: publish each deck two days before its lecture.
const releasedSlides = new Set<string>([]);

const weeks = [
  {
    week: "01",
    module: "Agent-system foundations",
    outcome: "Define the complete agent system and reason about sequential experience.",
    lectures: [
      ["Agent Systems: The Model Is Not the Agent", "W1-L1-Agent-Systems-The-Model-Is-Not-the-Agent.pptx"],
      ["RL Essentials for Agents", "W1-L2-RL-Essentials-for-Agents.pptx"]
    ]
  },
  {
    week: "02",
    module: "Learning agent policies",
    outcome: "Learn from demonstrations, preferences, and verifiable feedback.",
    lectures: [
      ["Learning Agent Policies from Feedback", "W2-L1-Learning-Agent-Policies-from-Feedback.pptx"],
      ["Training Multi-Turn Agents: Rollouts, Credit, and Stability", "W2-L2-Training-Multi-Turn-Agents.pptx"]
    ]
  },
  {
    week: "03",
    module: "Reasoning and adaptive inference",
    outcome: "Control search, verification, compute, recovery, and stopping at test time.",
    lectures: [
      ["Reasoning at Test Time: Traces, Search, Verifiers, and Compute", "W3-L1-Reasoning-at-Test-Time.pptx"],
      ["Adaptive Inference Control: Critics, Stopping, Recovery, and Efficiency", "W3-L2-Adaptive-Inference-Control.pptx"]
    ]
  },
  {
    week: "04",
    module: "Planning, state, memory, and context",
    outcome: "Build explicit state and memory that support controlled replanning.",
    lectures: [
      ["Planning and State", "W4-L1-Planning-and-State.pptx"],
      ["Memory and Context Engineering", "W4-L2-Memory-and-Context-Engineering.pptx"]
    ]
  },
  {
    week: "05",
    module: "Tools, protocols, and authority",
    outcome: "Design typed tools with bounded authority, verification, and audit.",
    lectures: [
      ["Tool Interfaces and Action Protocols", "W5-L1-Tool-Interfaces-and-Action-Protocols.pptx"],
      ["Authorization and Safe Execution", "W5-L2-Authorization-and-Safe-Execution.pptx"]
    ]
  },
  {
    week: "06",
    module: "Durable composition",
    outcome: "Compose agents into workflows and justified multi-agent teams.",
    lectures: [
      ["Agentic Workflows and Orchestration", "W6-L1-Agentic-Workflows-and-Orchestration.pptx"],
      ["Multi-Agent Systems", "W6-L2-Multi-Agent-Systems.pptx"]
    ]
  },
  {
    week: "07",
    module: "Web agents",
    outcome: "Build browser agents that ground actions and resist adversarial content.",
    lectures: [
      ["Web Agents: Perception, Control, and Evaluation", "W7-L1-Web-Agents-Perception-Control-and-Evaluation.pptx"],
      ["Securing Web Agents: Intent, Privilege, and Adversarial Content", "W7-L2-Securing-Web-Agents-Intent-Privilege-and-Adversarial-Content.pptx"]
    ]
  },
  {
    week: "08",
    module: "Coding agents",
    outcome: "Navigate repositories, execute repair loops, and evaluate patches validly.",
    lectures: [
      ["Coding Agents: Repository Navigation and Repair Loops", "W8-L1-Coding-Agents-Repository-Navigation-and-Repair-Loops.pptx"],
      ["Coding Agents II: Execution, Training, and Valid Evaluation", "W8-L2-Coding-Agents-Execution-Training-and-Valid-Evaluation.pptx"]
    ]
  },
  {
    week: "09",
    module: "Research and scientific agents",
    outcome: "Connect sources, claims, hypotheses, experiments, and qualified conclusions.",
    lectures: [
      ["Deep Research Agents: Search, Evidence, and Reproducible Synthesis", "W9-L1-Deep-Research-Agents-Search-Evidence-and-Reproducible-Synthesis.pptx"],
      ["Scientific Discovery Agents: Hypotheses, Experiments, and Valid Claims", "W9-L2-Scientific-Discovery-Agents-Hypotheses-Experiments-and-Valid-Claims.pptx"]
    ]
  },
  {
    week: "10",
    module: "Embodied agents and robotics",
    outcome: "Design and evaluate closed-loop world-model and vision-language-action agents.",
    lectures: [
      ["World Models and Vision-Language-Action Agents", "W10-L1-World-Models-and-Vision-Language-Action-Agents.pptx"],
      ["Data-Efficient Embodied Learning and Evaluation", "W10-L2-Data-Efficient-Embodied-Learning-and-Evaluation.pptx"]
    ]
  },
  {
    week: "11",
    module: "Agent robustness and safety",
    outcome: "Threat-model the lifecycle and plan prevention, monitoring, and recovery.",
    lectures: [
      ["Adversarial Threats Across the Agent Lifecycle", "W11-L1-Adversarial-Threats-Across-the-Agent-Lifecycle.pptx"],
      ["Defense in Depth, Monitoring, and Incident Response", "W11-L2-Defense-in-Depth-Monitoring-and-Incident-Response.pptx"]
    ]
  },
  {
    week: "12",
    module: "Learning from experience and self-improvement",
    outcome: "Govern persistent adaptation with evaluation, lineage, retention, and rollback.",
    lectures: [
      ["Learning from Experience: Prompts, Skills, Policies, and Continual Adaptation", "W12-L1-Learning-from-Experience-Prompts-Skills-Policies-and-Continual-Adaptation.pptx"],
      ["Self-Modifying and Evolutionary Agents", "W12-L2-Self-Modifying-and-Evolutionary-Agents.pptx"]
    ]
  },
  {
    week: "13",
    module: "Evaluation, provenance, and synthesis",
    outcome: "Make deployment decisions from reproducible evidence and accountable provenance.",
    lectures: [
      ["Agent Evaluation and Deployment Evidence", "W13-L1-Agent-Evaluation-and-Deployment-Evidence.pptx"],
      ["Provenance, Watermarking, and Frontier Challenges", "W13-L2-Provenance-Watermarking-and-Frontier-Challenges.pptx"]
    ]
  }
];

const assessments = [
  ["10%", "Trace diagnosis", "Short in-class analysis of agent behavior and failure."],
  ["20%", "Implementation labs", "Minimal agents, tool boundaries, evaluation, and red-teaming."],
  ["30%", "Midterm package", "Literature map, runnable baseline, results, and evaluation plan."],
  ["20%", "Final presentation", "A concise claim–evidence narrative with limitations."],
  ["20%", "Final artifacts", "Paper-style report, code, traces, ablations, and safety analysis."]
];

const milestones = [
  ["Weeks 1–2", "Choose and form teams", "Select a project from the course catalog, personalize its direction, and establish a shared workspace."],
  ["Week 4", "Proposal", "Submit the task contract, benchmark or environment, and one-page plan."],
  ["Week 6", "Baseline", "Deliver a runnable baseline and the first reproducible evidence bundle."],
  ["Week 8", "Midterm package", "Report preliminary results and a concrete failure taxonomy."],
  ["Week 10", "Freeze evaluation", "Lock held-out tasks, metrics, budgets, and contamination controls."],
  ["Week 12", "Artifact audit", "Peer review, regression check, security test, and release rehearsal."],
  ["Finals", "Present and release", "Seven-minute presentation, paper-style report, and runnable artifacts."]
];

const references = [
  ["Reinforcement Learning: An Introduction", "Sutton & Barto · 2018", "https://web.stanford.edu/class/psych209/Readings/SuttonBartoIPRLBook2ndEd.pdf"],
  ["A Survey on Large Language Model Based Autonomous Agents", "Wang et al. · 2024", "https://arxiv.org/abs/2308.11432"],
  ["Direct Preference Optimization", "Rafailov et al. · 2023", "https://arxiv.org/abs/2305.18290"],
  ["ReAct: Synergizing Reasoning and Acting", "Yao et al. · 2023", "https://arxiv.org/abs/2210.03629"],
  ["Toolformer", "Schick et al. · 2023", "https://arxiv.org/abs/2302.04761"],
  ["WebArena", "Zhou et al. · 2024", "https://arxiv.org/abs/2307.13854"],
  ["SWE-bench", "Jimenez et al. · 2024", "https://arxiv.org/abs/2310.06770"]
];

---

<BaseLayout
  title="CMSC 848N — Generative AI Agents · Fall 2026"
  description="Fall 2026 at the University of Maryland: foundations and frontiers of generative AI agents."
  image="/courses/cmsc848n/fall-2026/og.png"
  imageAlt="CMSC 848N Generative AI Agents · Fall 2026 · University of Maryland"
>
  <section class="shell course-hero">
    <div class="course-hero-copy">
      <p class="eyebrow">Fall 2026 · CMSC 848N · University of Maryland</p>
      <h1>Generative<br /><em>AI Agents</em></h1>
      <p class="course-lede">
        Foundations and frontiers of systems that reason, plan, act, use tools, and adapt in complex environments.
      </p>
      <div class="button-row">
        <a class="button" href="#schedule">View schedule <span aria-hidden="true">↓</span></a>
        <a class="button secondary" href="#projects">Join a project <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <aside class="course-at-a-glance" aria-label="Course at a glance">
      <p class="eyebrow">At a glance</p>
      <div><strong>13</strong><span>weeks</span></div>
      <div><strong>26</strong><span>lectures</span></div>
      <div><strong>01</strong><span>personalized research project</span></div>
      <p>Meeting time, room, and office hours will be posted before the semester begins.</p>
    </aside>
  </section>

  <nav class="shell course-quick-links" aria-label="Course shortcuts">
    <a href="#overview"><span>01</span> Overview</a>
    <a href="#schedule"><span>02</span> Schedule & slides</a>
    <a href="#projects"><span>03</span> Project signup</a>
    <a href="#policies"><span>04</span> Policies</a>
  </nav>

  <section id="overview" class="shell section course-overview">
    <div class="course-section-heading">
      <div>
        <p class="eyebrow">The course</p>
        <h2>Build agents whose claims can survive contact with the world.</h2>
      </div>
      <div>
        <p>
          An agent is more than a model. It is a governed sequential decision system: model, controller, environment, state and memory, tools and protocols, authority policy, evaluator, and people.
        </p>
        <p>
          We will connect theoretical foundations to modern practice, with an emphasis on algorithmic building blocks, valid evaluation, and open research problems.
        </p>
      </div>
    </div>

    <div class="course-facts">
      <article><span>Instructor</span><strong>Prof. Furong Huang</strong><p>Computer Science · UMD</p></article>
      <article><span>Format</span><strong>Two lectures per week</strong><p>75 minutes each · time and room TBA</p></article>
      <article><span>Prerequisites</span><strong>ML + deep learning</strong><p>Probability, optimization, linear algebra, and Python</p></article>
      <article><span>Coursework</span><strong>Evidence over demos</strong><p>Diagnosis, implementation, and one personalized research project</p></article>
    </div>
  </section>

  <section id="schedule" class="course-band">
    <div class="shell section">
      <div class="course-section-heading compact">
        <div><p class="eyebrow">Schedule & slides</p><h2>Thirteen weeks, one cumulative argument.</h2></div>
        <p>Lecture titles are posted now. Each approved deck will appear two days before its lecture; dates and readings will be added as the semester calendar is finalized.</p>
      </div>

      <ol class="course-schedule">
        {weeks.map(({ week, module, outcome, lectures }) => (
          <li>
            <div class="week-number"><span>Week</span><strong>{week}</strong></div>
            <div class="week-topic"><h3>{module}</h3><p>{outcome}</p></div>
            <div class="week-lectures">
              {lectures.map(([title, file], index) => releasedSlides.has(file) ? (
                <a class="lecture-item" href={`${slideRoot}/${file}`} download>
                  <span>L{index + 1}</span>
                  <strong>{title}</strong>
                  <small>PPTX ↓</small>
                </a>
              ) : (
                <div class="lecture-item is-pending">
                  <span>L{index + 1}</span>
                  <strong>{title}</strong>
                  <small>Posts 2 days before class</small>
                </div>
              ))}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="projects" class="shell section projects-section">
    <div class="course-section-heading">
      <div><p class="eyebrow">Personalized research project</p><h2>Choose one project. Make it your own.</h2></div>
      <div>
        <p>Professor Huang will publish a curated catalog of research projects. Students will choose one, then personalize its question, scope, system design, and evidence plan. Every project reports task success, end-to-end cost, latency, and reliability across repeated runs, with at least one ablation and one structured failure analysis.</p>
      </div>
    </div>

    <div class="project-signup-callout">
      <div>
        <p class="eyebrow">Project catalog</p>
        <h3>A focused menu, with room to explore.</h3>
        <p>The catalog will offer several concrete projects across the course themes. Once it opens, students can rank their choices, explain how they want to personalize the work, and find collaborators. Do not include student IDs or other private information.</p>
      </div>
      <div class="project-signup-actions">
        <span class="button course-button-light is-disabled">Catalog coming soon</span>
        <span>Signup opens with the catalog</span>
      </div>
    </div>

    <p class="eyebrow">Project families</p>
    <div class="project-directions" aria-label="Planned project families">
      <article><span>01</span><h3>Reasoning & control</h3><p>Search, verifiers, stopping, recovery, and test-time compute.</p></article>
      <article><span>02</span><h3>Memory & planning</h3><p>State representation, long-horizon control, and context engineering.</p></article>
      <article><span>03</span><h3>Web & code agents</h3><p>Grounded tool use, software repair, security, and evaluation.</p></article>
      <article><span>04</span><h3>Scientific agents</h3><p>Evidence synthesis, experiment design, and reproducible claims.</p></article>
      <article><span>05</span><h3>Embodied agents</h3><p>World models, VLA systems, data efficiency, and physical safety.</p></article>
      <article><span>06</span><h3>Robust self-improvement</h3><p>Continual adaptation, release gates, provenance, and rollback.</p></article>
    </div>

    <div class="milestone-section">
      <p class="eyebrow">Milestones</p>
      <ol class="milestone-list">
        {milestones.map(([when, title, detail]) => (
          <li><span>{when}</span><strong>{title}</strong><p>{detail}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="course-band assessment-band">
    <div class="shell section">
      <div class="course-section-heading compact">
        <div><p class="eyebrow">Assessment</p><h2>Measure the work by its evidence.</h2></div>
        <p>The final syllabus will confirm all due dates and policies. The planned weighting below anchors the course design.</p>
      </div>
      <div class="assessment-grid">
        {assessments.map(([weight, title, detail]) => (
          <article><strong>{weight}</strong><h3>{title}</h3><p>{detail}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section id="resources" class="shell section resources-section">
    <div class="course-section-heading compact">
      <div><p class="eyebrow">Starting references</p><h2>Read the primary work.</h2></div>
      <p>Additional readings will be posted by week. We will distinguish peer-reviewed work, preprints, official specifications, vendor evidence, and course synthesis.</p>
    </div>
    <div class="reference-list">
      {references.map(([title, meta, url], index) => (
        <a href={url}>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <strong>{title}</strong>
          <small>{meta}</small>
          <i aria-hidden="true">↗</i>
        </a>
      ))}
    </div>
  </section>

  <section id="policies" class="shell section policies-section">
    <div class="course-section-heading compact">
      <div><p class="eyebrow">Working policies</p><h2>Clear expectations, before launch.</h2></div>
      <p>These are planning guidelines. The official Fall 2026 syllabus and University policies will supersede this page where they differ.</p>
    </div>
    <div class="policy-grid">
      <article><h3>Collaboration</h3><p>Collaboration is expected within project teams. Individual assessments must reflect your own understanding. Credit every external contribution, library, model, dataset, prompt source, and borrowed artifact.</p></article>
      <article><h3>Generative AI use</h3><p>AI tools are part of the subject matter and may be used when the assignment permits. Preserve prompts, model and version information, tool traces, and material edits so results remain auditable.</p></article>
      <article><h3>Responsible experimentation</h3><p>Use least privilege, sandbox side effects, protect private data, and obtain approval before tests that touch people or external systems. Projects with consequential actions require monitoring and rollback ownership.</p></article>
      <article><h3>Accessibility & support</h3><p>Students who need accommodations should contact the University’s accessibility service and the instructor early. Please raise barriers to course materials or participation as soon as possible.</p></article>
    </div>
  </section>

  <section class="shell course-final-cta">
    <p class="eyebrow">CMSC 848N · Fall 2026</p>
    <h2>Models speak. Agents change state.</h2>
    <p>Our job is to understand the system in between—and demand evidence for what it can safely do.</p>
    <div class="button-row">
      <a class="button" href="#schedule">Download slides</a>
      <a class="button secondary" href="#projects">View project plan ↑</a>
    </div>
  </section>
</BaseLayout>

<style>
