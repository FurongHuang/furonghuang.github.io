---
import BaseLayout from "../layouts/BaseLayout.astro";
import { existsSync, readdirSync } from "node:fs";
import { resolve } from "node:path";

const slideRoot = "/courses/cmsc848n/fall-2026/slides";
const slideDirectory = resolve(process.cwd(), "public/courses/cmsc848n/fall-2026/slides");
const releasedSlides = new Set<string>(
  existsSync(slideDirectory)
    ? readdirSync(slideDirectory).filter((filename) => filename.toLowerCase().endsWith(".pdf"))
    : []
);

const getPublishedSlideFilename = (filename: string) => filename.replace(/\.pptx$/i, ".pdf");

const courseDateFormatter = new Intl.DateTimeFormat("en-US", {
  timeZone: "UTC",
  weekday: "short",
  month: "short",
  day: "numeric"
});

const formatCourseDate = (date: string) => courseDateFormatter.format(new Date(`${date}T12:00:00Z`));
const formatReleaseDate = (date: string) => {
  const releaseDate = new Date(`${date}T12:00:00Z`);
  releaseDate.setUTCDate(releaseDate.getUTCDate() - 2);
  return courseDateFormatter.format(releaseDate);
};

const modules = [
  {
    number: "01",
    module: "Agent-system foundations",
    outcome: "Define the complete agent system and reason about sequential experience.",
    lectures: [
      ["2026-09-01", "Agent Systems: The Model Is Not the Agent", "W1-L1-Agent-Systems-The-Model-Is-Not-the-Agent.pptx"],
      ["2026-09-03", "Reinforcement Learning for Generative Agents", "W1-L2-2026-Reinforcement-Learning-for-Generative-Agents.pptx"]
    ]
  },
  {
    number: "02",
    module: "Learning agent policies",
    outcome: "Learn from demonstrations, preferences, and verifiable feedback.",
    lectures: [
      ["2026-09-08", "Policy Gradients and Learning from Feedback", "W2-L1-2026-Policy-Gradients-and-Learning-from-Feedback.pptx"],
      ["2026-09-10", "DeepSeek-R1, GRPO, and Agentic Reinforcement Learning", "W2-L2-2026-DeepSeek-R1-GRPO-and-Agentic-RL.pptx"]
    ]
  },
  {
    number: "03",
    module: "Reasoning and adaptive inference",
    outcome: "Control search, verification, compute, recovery, and stopping at test time.",
    lectures: [
      ["2026-09-15", "Alignment from DPO to Controlled Decoding", "W3-L1-2026-Alignment-DPO-to-Controlled-Decoding.pptx"],
      ["2026-09-17", "Adaptive Inference Control: Critics, Stopping, Recovery, and Efficiency", "W3-L2-Adaptive-Inference-Control.pptx"]
    ]
  },
  {
    number: "04",
    module: "Planning, state, memory, and context",
    outcome: "Build explicit state and memory that support controlled replanning.",
    lectures: [
      ["2026-09-22", "Planning and State", "W4-L1-Planning-and-State.pptx"],
      ["2026-09-24", "Memory and Context Engineering", "W4-L2-Memory-and-Context-Engineering.pptx"]
    ]
  },
  {
    number: "05",
    module: "Tools, protocols, and authority",
    outcome: "Design typed tools with bounded authority, verification, and audit.",
    lectures: [
      ["2026-09-29", "Tool Interfaces and Action Protocols", "W5-L1-Tool-Interfaces-and-Action-Protocols.pptx"],
      ["2026-10-01", "Authorization and Safe Execution", "W5-L2-Authorization-and-Safe-Execution.pptx"]
    ]
  },
  {
    number: "06",
    module: "Durable composition",
    outcome: "Compose agents into workflows and justified multi-agent teams.",
    lectures: [
      ["2026-10-06", "Agentic Workflows and Orchestration", "W6-L1-Agentic-Workflows-and-Orchestration.pptx"],
      ["2026-10-08", "Multi-Agent Systems", "W6-L2-Multi-Agent-Systems.pptx"]
    ]
  },
  {
    number: "07",
    module: "Web agents",
    outcome: "Build browser agents that ground actions and resist adversarial content.",
    lectures: [
      ["2026-10-15", "Web Agents: Perception, Control, and Evaluation", "W7-L1-Web-Agents-Perception-Control-and-Evaluation.pptx"],
      ["2026-10-20", "Securing Web Agents: Intent, Privilege, and Adversarial Content", "W7-L2-Securing-Web-Agents-Intent-Privilege-and-Adversarial-Content.pptx"]
    ]
  },
  {
    number: "08",
    module: "Coding agents",
    outcome: "Navigate repositories, execute repair loops, and evaluate patches validly.",
    lectures: [
      ["2026-10-22", "Coding Agents: Repository Navigation and Repair Loops", "W8-L1-Coding-Agents-Repository-Navigation-and-Repair-Loops.pptx"],
      ["2026-10-27", "Coding Agents II: Execution, Training, and Valid Evaluation", "W8-L2-Coding-Agents-Execution-Training-and-Valid-Evaluation.pptx"]
    ]
  },
  {
    number: "09",
    module: "Research and scientific agents",
    outcome: "Connect sources, claims, hypotheses, experiments, and qualified conclusions.",
    lectures: [
      ["2026-10-29", "Deep Research Agents: Search, Evidence, and Reproducible Synthesis", "W9-L1-Deep-Research-Agents-Search-Evidence-and-Reproducible-Synthesis.pptx"],
      ["2026-11-03", "Scientific Discovery Agents: Hypotheses, Experiments, and Valid Claims", "W9-L2-Scientific-Discovery-Agents-Hypotheses-Experiments-and-Valid-Claims.pptx"]
    ]
  },
  {
    number: "10",
    module: "Embodied agents and robotics",
    outcome: "Design and evaluate closed-loop world-model and vision-language-action agents.",
    lectures: [
      ["2026-11-05", "World Models and Vision-Language-Action Agents", "W10-L1-World-Models-and-Vision-Language-Action-Agents.pptx"],
      ["2026-11-10", "Data-Efficient Embodied Learning and Evaluation", "W10-L2-Data-Efficient-Embodied-Learning-and-Evaluation.pptx"]
    ]
  },
  {
    number: "11",
    module: "Agent robustness and safety",
    outcome: "Threat-model the lifecycle and plan prevention, monitoring, and recovery.",
    lectures: [
      ["2026-11-12", "Adversarial Threats Across the Agent Lifecycle", "W11-L1-Adversarial-Threats-Across-the-Agent-Lifecycle.pptx"],
      ["2026-11-17", "Defense in Depth, Monitoring, and Incident Response", "W11-L2-Defense-in-Depth-Monitoring-and-Incident-Response.pptx"]
    ]
  },
  {
    number: "12",
    module: "Learning from experience and self-improvement",
    outcome: "Govern persistent adaptation with evaluation, lineage, retention, and rollback.",
    lectures: [
      ["2026-11-19", "Learning from Experience: Prompts, Skills, Policies, and Continual Adaptation", "W12-L1-Learning-from-Experience-Prompts-Skills-Policies-and-Continual-Adaptation.pptx"],
      ["2026-11-24", "Self-Modifying and Evolutionary Agents", "W12-L2-Self-Modifying-and-Evolutionary-Agents.pptx"]
    ]
  },
  {
    number: "13",
    module: "Evaluation, provenance, and synthesis",
    outcome: "Make deployment decisions from reproducible evidence and accountable provenance.",
    lectures: [
      ["2026-12-01", "Agent Evaluation and Deployment Evidence", "W13-L1-Agent-Evaluation-and-Deployment-Evidence.pptx"],
      ["2026-12-03", "Provenance, Watermarking, and Frontier Challenges", "W13-L2-Provenance-Watermarking-and-Frontier-Challenges.pptx"]
    ]
  }
];

const assessments = [
  ["10%", "In-class quizzes", "Impromptu short quizzes during lectures.", "Sep 1–Dec 3"],
  ["20%", "Homework", "Three assignments covering the course material.", "Sep 30 · Oct 30 · Nov 30"],
  ["30%", "Midterm report", "Project progress, a literature review, and baseline results.", "Oct 15"],
  ["20%", "Final presentation", "A concise presentation of the project, results, and limitations.", "Dec 8 & 10"],
  ["20%", "Final report and artifacts", "A research or engineering report, runnable code, and supporting evidence.", "Dec 11"]
];

const projectRubrics = [
  {
    "title": "Midterm package",
    "weight": "30% of course grade",
    "rows": [
      [
        "Problem and scope",
        20,
        "A precise question or use case, motivated by a concrete limitation; clearly defined success criteria and a feasible semester scope."
      ],
      [
        "Related work and baseline",
        25,
        "Accurate discussion of the closest approaches, verified citations, and a runnable baseline appropriate to the question."
      ],
      [
        "Preliminary evidence",
        30,
        "An end-to-end experiment or prototype, interpretable measurements, and an analysis of failures and uncertainty."
      ],
      [
        "Evaluation plan and milestones",
        25,
        "Held-out tasks, meaningful metrics, fair comparisons, resource budgets, major risks, and a credible plan for the remaining work."
      ]
    ]
  },
  {
    "title": "Final presentation",
    "weight": "20% of course grade",
    "rows": [
      [
        "Problem and approach",
        20,
        "Clear motivation, necessary background, and an understandable explanation of the technical choices."
      ],
      [
        "Evidence and interpretation",
        40,
        "Results against appropriate baselines, readable figures, and conclusions supported by measurements. A demo supplements the evidence."
      ],
      [
        "Limitations and discussion",
        20,
        "Thoughtful treatment of failure cases, alternative explanations, uncertainty, and questions from the audience."
      ],
      [
        "Communication and contributions",
        20,
        "A coherent presentation within the allotted time, legible slides, and clearly identified contributions from each team member."
      ]
    ]
  },
  {
    "title": "Final artifacts: research track",
    "weight": "20% of course grade",
    "rows": [
      [
        "Research question and contribution",
        20,
        "A precise hypothesis and a clear account of what the work adds relative to the closest prior work."
      ],
      [
        "Experimental rigor",
        35,
        "Strong baselines, controlled comparisons, relevant ablations, held-out evaluation, and uncertainty estimates where appropriate."
      ],
      [
        "Technical correctness and analysis",
        25,
        "Correct methods and mathematics, defensible conclusions, and substantive analysis of failures and competing explanations."
      ],
      [
        "Reproducibility and reporting",
        20,
        "A clear paper-style report, runnable code, documented configurations and dependencies, and sufficient details to reproduce the main results."
      ]
    ]
  },
  {
    "title": "Final artifacts: engineering track",
    "weight": "20% of course grade",
    "rows": [
      [
        "Correctness and reliability",
        35,
        "An end-to-end system meeting agreed requirements, with automated tests, failure handling, and appropriate security and privacy protections."
      ],
      [
        "Evaluation",
        25,
        "Comparison with a simple baseline under documented workloads, measuring relevant quality, latency, cost, or usability outcomes."
      ],
      [
        "System design",
        20,
        "Well-justified interfaces and architectural choices, explicit tradeoffs, and a maintainable implementation."
      ],
      [
        "Reproducibility and documentation",
        20,
        "Reliable setup instructions, a repeatable demo, test commands, configurations, and clearly documented limitations."
      ]
    ]
  }
];

const milestones = [
  ["Weeks 1–2", "Rank projects and form teams", "Submit project preferences, propose one personalization, and establish a shared workspace with a team of up to three students."],
  ["Week 4", "Proposal", "Submit the task contract, benchmark or environment, and one-page plan."],
  ["Week 6", "Baseline", "Deliver a runnable baseline and the first reproducible evidence bundle."],
  ["Week 8", "Midterm report", "Report preliminary results and a concrete failure taxonomy."],
  ["Week 10", "Freeze evaluation", "Lock held-out tasks, metrics, budgets, and contamination controls."],
  ["Week 12", "Artifact audit", "Peer review, regression check, security test, and release rehearsal."],
  ["Dec 8 & 10", "Present and submit", "Deliver the final presentation, paper-style report, runnable code, and supporting evidence."]
];

const projectBriefFields = [
  ["01", "Motivation & gap", "Why the problem matters and what unresolved gap makes it worth pursuing."],
  ["02", "Question & novelty", "A concrete research question and the seed of a new, defensible contribution."],
  ["03", "Closest prior work", "Starting references, relevant systems, and the work a new result must improve upon."],
  ["04", "Research hypothesis", "A technically credible first route, with space for the team to develop its own approach."],
  ["05", "Data & baselines", "Datasets, environments, comparison points, and practical starting assets."],
  ["06", "Conference-level evidence", "Metrics, budgets, strong baselines, ablations, and failure analyses for a valid claim."],
  ["07", "Research artifacts", "A conference-style paper, reproducible code, evidence, and a concise presentation."]
];

const references = [
  ["Reinforcement Learning: An Introduction (2nd edition)","Sutton & Barto · 2018","https://web.stanford.edu/class/psych209/Readings/SuttonBartoIPRLBook2ndEd.pdf","Core","Module 01"],
  ["A Survey on Large Language Model based Autonomous Agents","Wang et al. · arXiv 2023","https://arxiv.org/abs/2308.11432","Further","Module 01"],
  ["Proximal Policy Optimization Algorithms","Schulman et al. · arXiv 2017","https://arxiv.org/abs/1707.06347","Further","Modules 01–02"],
  ["Training language models to follow instructions with human feedback","Ouyang et al. · arXiv 2022","https://arxiv.org/abs/2203.02155","Core","Module 02"],
  ["Direct Preference Optimization: Your Language Model is Secretly a Reward Model","Rafailov et al. · arXiv 2023","https://arxiv.org/abs/2305.18290","Core","Module 02"],
  ["DeepSeekMath: Pushing the Limits of Mathematical Reasoning in Open Language Models","Shao et al. · arXiv 2024","https://arxiv.org/abs/2402.03300","Further","Module 02 · GRPO"],
  ["DeepSeek-R1 incentivizes reasoning in LLMs through reinforcement learning","Guo et al. · Nature 2025","https://www.nature.com/articles/s41586-025-09422-z","Further","Modules 02–03"],
  ["Chain-of-Thought Prompting Elicits Reasoning in Large Language Models","Wei et al. · arXiv 2022","https://arxiv.org/abs/2201.11903","Further","Module 03"],
  ["Tree of Thoughts: Deliberate Problem Solving with Large Language Models","Yao et al. · arXiv 2023","https://arxiv.org/abs/2305.10601","Further","Module 03"],
  ["ReAct: Synergizing Reasoning and Acting in Language Models","Yao et al. · arXiv 2022","https://arxiv.org/abs/2210.03629","Core","Modules 03 & 05"],
  ["Generative Agents: Interactive Simulacra of Human Behavior","Park et al. · arXiv 2023","https://arxiv.org/abs/2304.03442","Core","Module 04"],
  ["Toolformer: Language Models Can Teach Themselves to Use Tools","Schick et al. · arXiv 2023","https://arxiv.org/abs/2302.04761","Core","Module 05"],
  ["AutoGen: Enabling Next-Gen LLM Applications via Multi-Agent Conversation","Wu et al. · arXiv 2023","https://arxiv.org/abs/2308.08155","Core","Module 06"],
  ["WebArena: A Realistic Web Environment for Building Autonomous Agents","Zhou et al. · arXiv 2023","https://arxiv.org/abs/2307.13854","Core","Module 07"],
  ["AgentDojo: A Dynamic Environment to Evaluate Prompt Injection Attacks and Defenses for LLM Agents","Debenedetti et al. · arXiv 2024","https://arxiv.org/abs/2406.13352","Core","Modules 07 & 11"],
  ["SWE-bench: Can Language Models Resolve Real-World GitHub Issues?","Jimenez et al. · arXiv 2023","https://arxiv.org/abs/2310.06770","Further","Module 08"],
  ["SWE-agent: Agent-Computer Interfaces Enable Automated Software Engineering","Yang et al. · arXiv 2024","https://arxiv.org/abs/2405.15793","Core","Module 08"],
  ["The AI Scientist: Towards Fully Automated Open-Ended Scientific Discovery","Lu et al. · arXiv 2024","https://arxiv.org/abs/2408.06292","Core","Module 09"],
  ["Mastering diverse control tasks through world models","Hafner et al. · Nature 2025","https://www.nature.com/articles/s41586-025-08744-2","Further","Module 10"],
  ["OpenVLA: An Open-Source Vision-Language-Action Model","Kim et al. · arXiv 2024","https://arxiv.org/abs/2406.09246","Core","Module 10"],
  ["Reflexion: Language Agents with Verbal Reinforcement Learning","Shinn et al. · arXiv 2023","https://arxiv.org/abs/2303.11366","Core","Module 12"],
  ["AgentBench: Evaluating LLMs as Agents","Liu et al. · arXiv 2023","https://arxiv.org/abs/2308.03688","Core","Module 13"]
];

const prerequisiteReadings = [
  ["Mathematics for Machine Learning (Math4ML)", "Calculus & linear algebra", "https://users.umiacs.umd.edu/~hal3/courses/2013S_ML/math4ml.pdf"],
  ["Linear Algebra Review", "Calculus & linear algebra", "https://www.cs.umd.edu/class/fall2019/cmsc726/materials/linear-algebra-review.pdf"],
  ["Advanced Linear Algebra Review", "Calculus & linear algebra", "https://www.cs.umd.edu/~tomg/course/cmsc764/L1_linalg_review.pdf"],
  ["Convex Analysis Review", "Optimization", "https://www.cs.umd.edu/class/fall2019/cmsc726/materials/convex-review.pdf"],
  ["Optimization Review", "Optimization", "https://www.cs.umd.edu/~tomg/course/cmsc764/L3_optimization_problems_overview.pdf"],
  ["Probability Review", "Probability & statistics", "https://www.cs.umd.edu/class/fall2019/cmsc726/materials/prob-review.pdf"]
];

---

<BaseLayout
  title="CMSC 848N — Generative AI Agents · Fall 2026"
  hidePersonalContact
  description="Fall 2026 at the University of Maryland: foundations and frontiers of generative AI agents."
  image="/courses/cmsc848n/fall-2026/og.png"
  imageAlt="CMSC 848N Generative AI Agents · Fall 2026 · University of Maryland"
>
  <section class="shell course-hero">
    <div class="course-hero-copy">
      <p class="eyebrow">Fall 2026 · CMSC 848N · University of Maryland</p>
      <h1>Generative<br /><em>AI Agents</em></h1>
      <p class="course-lede">
        Foundations and frontiers of systems that reason, plan, act, use tools, and adapt in complex environments.
      </p>
      <div class="button-row">
        <a class="button" href="#schedule">View schedule <span aria-hidden="true">↓</span></a>
        <a class="button secondary" href="#projects">Explore projects <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <aside class="course-at-a-glance" aria-label="Course at a glance">
      <p class="eyebrow">At a glance</p>
      <div><strong>15</strong><span>semester weeks</span></div>
      <div><strong>26</strong><span>lectures</span></div>
      <div><strong>27</strong><span>personalized research projects</span></div>
      <p>Tuesdays & Thursdays · 11:00 a.m.–12:15 p.m. · CSI 3117</p>
    </aside>
  </section>

  <nav class="shell course-quick-links" aria-label="Course shortcuts">
    <a href="#overview"><span>01</span> Overview</a>
    <a href="#schedule"><span>02</span> Schedule & slides</a>
    <a href="#projects"><span>03</span> Projects</a>
    <a href="#policies"><span>04</span> Policies</a>
  </nav>

  <section id="overview" class="shell section course-overview">
    <div class="course-section-heading">
      <div>
        <p class="eyebrow">The course</p>
        <h2>Build agents whose claims can survive contact with the world.</h2>
      </div>
      <div>
        <p>
          An agent is more than a model. It is a governed sequential decision system: model, controller, environment, state and memory, tools and protocols, authority policy, evaluator, and people.
        </p>
        <p>
          We will connect theoretical foundations to modern practice, with an emphasis on algorithmic building blocks, valid evaluation, and open research problems.
        </p>
      </div>
    </div>

    <div class="course-facts">
      <article>
        <span>Course team</span>
        <strong>Prof. Furong Huang</strong>
        <p>Instructors (TAs)</p>
        <div class="course-ta-list" aria-label="Instructors (TAs)">
          <div class="course-ta-person">
            <div class="course-ta-avatar" aria-hidden="true">YP</div>
            <b>
              <a class="course-ta-profile" href="https://www.linkedin.com/in/yucheng-pan-410a422a2/" target="_blank" rel="noopener noreferrer" aria-label="Yucheng Pan on LinkedIn (opens in a new tab)">Yucheng Pan <i aria-hidden="true">↗</i></a>
              <a class="course-ta-email" href="mailto:ycpan@umd.edu">ycpan@umd.edu</a>
            </b>
          </div>
          <div class="course-ta-person">
            <img src="/assets/people/yijun-liang.jpg" alt="Yijun Liang" width="48" height="48" loading="lazy" decoding="async" />
            <b>Yijun Liang<br /><a class="course-ta-email" href="mailto:yliang17@umd.edu">yliang17@umd.edu</a></b>
          </div>
          <div class="course-ta-person">
            <img src="/assets/people/taewon-kang.jpg" alt="Taewon Kang" width="48" height="48" loading="lazy" decoding="async" />
            <b>
              <a class="course-ta-profile" href="https://www.cs.umd.edu/people/taewon" target="_blank" rel="noopener noreferrer" aria-label="Taewon Kang's UMD profile (opens in a new tab)">Taewon Kang <i aria-hidden="true">↗</i></a>
              <a class="course-ta-email" href="mailto:taewon@umd.edu">taewon@umd.edu</a>
            </b>
          </div>
        </div>
      </article>
      <article><span>Meetings</span><strong>Tue & Thu · 11:00–12:15</strong><p>CSI 3117 · America/New_York</p></article>
      <article><span>Prerequisites</span><strong>ML + deep learning</strong><p>Probability, optimization, linear algebra, and Python</p></article>
      <article><span>Coursework</span><strong>Evidence over demos</strong><p>Diagnosis, implementation, and one personalized research project</p></article>
      <article><span>Expected workload</span><strong>8–12 hours per week</strong><p>Readings, homework, experiments, and team research</p></article>
      <article><span>Communication</span><strong>ELMS + course Slack</strong><p>Course links and office hours will be shared through ELMS and course Slack</p></article>
    </div>
  </section>

  <section id="schedule" class="course-band">
    <div class="shell section">
      <div class="course-section-heading compact">
        <div><p class="eyebrow">Schedule & slides</p><h2>Thirteen modules.</h2></div>
        <p>Fall classes run August 31–December 11. CMSC 848N meets September 1–December 10; lecture slides appear exactly two days before each 11:00 a.m. lecture. Dates follow the <a href="https://academiccatalog.umd.edu/about-university/academic-calendar/semester-calendar/semester-calendar.pdf">official UMD semester calendar</a>.</p>
      </div>

      <ol class="course-schedule">
        {modules.map(({ number, module, outcome, lectures }) => (
          <li>
            <div class="week-number"><span>Module</span><strong>{number}</strong></div>
            <div class="week-topic"><h3>{module}</h3><p>{outcome}</p></div>
            <div class="week-lectures">
              {lectures.map(([date, title, file], index) => releasedSlides.has(getPublishedSlideFilename(file)) ? (
                <a class="lecture-item" href={`${slideRoot}/${getPublishedSlideFilename(file)}`} download>
                  <div class="lecture-meta"><span>L{index + 1}</span><time datetime={date}>{formatCourseDate(date)}</time></div>
                  <strong>{title}</strong>
                  <small>PDF ↓</small>
                </a>
              ) : (
                <div class="lecture-item is-pending">
                  <div class="lecture-meta"><span>L{index + 1}</span><time datetime={date}>{formatCourseDate(date)}</time></div>
                  <strong>{title}</strong>
                  <small>Slides {formatReleaseDate(date)} · 11 AM</small>
                </div>
              ))}
            </div>
          </li>
        ))}
      </ol>

      <div class="calendar-markers" aria-label="Fall 2026 schedule exceptions and final meetings">
        <article><span>No class</span><strong>Tue · Oct 13</strong><p>UMD Fall Break</p></article>
        <article><span>No class</span><strong>Thu · Nov 26</strong><p>UMD Thanksgiving Recess</p></article>
        <article><span>Final meetings</span><strong>Dec 8 & 10 · 11:00 AM</strong><p>Personalized research project presentations</p></article>
      </div>
    </div>
  </section>

  <section id="projects" class="shell section projects-section">
    <div class="course-section-heading">
      <div><p class="eyebrow">Personalized research project</p><h2>Choose one project. Make it your own.</h2></div>
      <div>
        <p>Professor Huang is designing a new catalogue of ambitious research candidates for the class. Each begins with a real open problem and a credible path toward a publishable contribution. Detailed briefs are available to enrolled students with the course password.</p>
      </div>
    </div>

    <div
      class="project-signup-callout"
      data-catalog-lock
      data-catalog-url="/courses/cmsc848n/fall-2026/project-catalog.v1.json"
    >
      <div>
        <p class="eyebrow">Protected project catalogue</p>
        <h3>Unlock the research projects.</h3>
        <p>The detailed catalogue is encrypted. Enter the password shared by Professor Huang to review the candidate questions, technical hypotheses, evidence requirements, and starting papers.</p>
      </div>
      <form class="project-unlock-form" data-catalog-form>
        <label for="project-catalog-password">Course password</label>
        <div>
          <input
            id="project-catalog-password"
            name="password"
            type="password"
            autocomplete="current-password"
            spellcheck="false"
            required
            data-catalog-password
          />
          <button class="button course-button-light" type="submit" data-catalog-submit>Unlock</button>
        </div>
        <p role="status" aria-live="polite" data-catalog-status>Password is checked in this browser and is never submitted.</p>
      </form>
    </div>

    <noscript><p class="catalog-noscript">JavaScript is required to decrypt the protected project catalogue.</p></noscript>

    <div class="project-selection-section">
      <p class="eyebrow">How project selection works</p>
      <div class="project-directions selection-steps">
        <article><span>01</span><h3>Review</h3><p>Read the protected catalogue and identify several projects that fit your preparation and interests.</p></article>
