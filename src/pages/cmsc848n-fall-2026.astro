    box-shadow: var(--shadow);
  }
  .project-signup-callout h3 { margin: 0; font-family: "Newsreader", serif; font-size: clamp(2.2rem, 4vw, 4rem); line-height: 0.98; }
  .project-signup-callout p:not(.eyebrow) { max-width: 700px; color: #c6d5df; }
  .project-signup-actions { display: grid; gap: 1rem; justify-items: center; min-width: 220px; }
  .project-signup-actions > span:last-child { color: #8dded8; font-size: 0.75rem; font-weight: 800; }
  .course-button-light { border-color: white; color: var(--ink); background: white; }
  .course-button-light.is-disabled { cursor: default; opacity: 0.92; }

  .project-directions { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.8rem; }
  .project-directions article { min-height: 210px; padding: 1.6rem; border: 1px solid var(--line); border-radius: 20px; background: var(--white); }
  .project-directions span { color: var(--teal); font-size: 0.7rem; font-weight: 800; }
  .project-directions h3 { margin: 3rem 0 0.6rem; font-family: "Newsreader", serif; font-size: 1.55rem; }
  .project-directions p { margin: 0; color: var(--ink-soft); font-size: 0.82rem; }

  .milestone-section { margin-top: 5rem; }
  .milestone-list { margin: 0; padding: 0; border-top: 1px solid var(--line); list-style: none; }
  .milestone-list li { display: grid; grid-template-columns: 150px 220px 1fr; gap: 2rem; padding: 1rem 0; border-bottom: 1px solid var(--line); }
  .milestone-list span { color: var(--teal); font-size: 0.75rem; font-weight: 800; }
