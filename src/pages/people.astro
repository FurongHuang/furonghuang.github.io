---
import BaseLayout from "../layouts/BaseLayout.astro";
import PersonCard from "../components/PersonCard.astro";
import { alumni, currentPhdStudents, postdocs } from "../data/people";

const placementDestinations = Array.from(
  new Set(
    alumni
      .map((person) => person.destination?.split(" · ")[0])
      .filter((destination): destination is string => Boolean(destination))
  )
).sort((left, right) => left.localeCompare(right, "en", { sensitivity: "base" }));
const onMarket = alumni.filter((person) => person.onMarket);
const placedAlumni = alumni.filter((person) => !person.onMarket);

const yearFromPeriod = (period?: string) => period?.match(/\b(?:19|20)\d{2}\b/)?.[0] || "Other";
const groupByYear = (people: typeof alumni) => {
  const groups = new Map<string, typeof alumni>();
  for (const person of people) {
    const year = yearFromPeriod(person.period);
    groups.set(year, [...(groups.get(year) || []), person]);
  }
  return Array.from(groups, ([year, members]) => ({ year, members }));
};

const currentCohorts = groupByYear(currentPhdStudents);
const alumniClasses = groupByYear(placedAlumni);
---

<BaseLayout title="People — Furong Lab" description="Current researchers and alumni of Furong Lab at the University of Maryland.">
  <section class="shell page-hero people-hero">
    <div>
      <p class="eyebrow">Furong Lab · University of Maryland</p>
      <h1>People building trustworthy AI.</h1>
      <p>A research community spanning foundation models, reasoning, robotics, safety, fairness, and learning theory.</p>
    </div>
    <img src="/assets/headshot.jpg" alt="Furong Huang" />
  </section>

  <section class="shell people-group-photo-section">
    <figure class="prospective-group-photo people-group-photo">
      <img
        src="/assets/people/furong-lab-group.jpg"
        alt="Furong Huang with members of Furong Lab outside a University of Maryland building"
        loading="lazy"
        decoding="async"
      />
      <figcaption>Furong Lab at the University of Maryland</figcaption>
    </figure>
  </section>

  <section class="shell section" style="padding-top: 1rem">
    <div class="section-heading">
      <div><p class="eyebrow">Current group</p><h2>Postdoctoral researcher.</h2></div>
      <p>Working across robotics, multimodal learning, world models, and trustworthy foundation models.</p>
    </div>
    <div class="people-grid compact-people">{postdocs.map((person) => <PersonCard person={person} />)}</div>
  </section>

  <section class="shell section">
    <div class="section-heading">
      <div><p class="eyebrow">Current group</p><h2>Doctoral advisees.</h2></div>
      <p>Students are grouped by starting cohort, with names ordered alphabetically within each cohort.</p>
    </div>
    <div class="people-cohort-stack">
      {currentCohorts.map(({ year, members }) => (
        <section class="people-cohort" aria-label={`Ph.D. students who started in ${year}`}>
          <div class="people-cohort-label">
            <strong>Started {year}</strong>
            <span>{members.length} {members.length === 1 ? "researcher" : "researchers"}</span>
          </div>
          <div class="people-grid">{members.map((person) => <PersonCard person={person} />)}</div>
        </section>
      ))}
    </div>
  </section>

  <section class="alumni-band" id="alumni">
    <div class="shell section">
      <div class="section-heading">
        <div><p class="eyebrow">Alumni outcomes</p><h2>Great researchers, building what comes next.</h2></div>
        <p>Graduates and former advisees carry Furong Lab’s work into leading research organizations, industry laboratories, and academia.</p>
      </div>
      <div class="people-destinations" aria-label="Alumni organizations">
        {placementDestinations.map((destination) => <span>{destination}</span>)}
      </div>
      <div class="market-roster">
        <div>
          <p class="eyebrow">On the market</p>
          <h3>Researchers ready for their next chapter.</h3>
          <p>Meet recent Furong Lab graduates currently exploring research and industry opportunities.</p>
        </div>
        <div class="people-grid market-grid">{onMarket.map((person) => <PersonCard person={person} />)}</div>
      </div>
      <div class="people-cohort-stack alumni-cohort-stack">
        {alumniClasses.map(({ year, members }) => (
          <section class="people-cohort" aria-label={`Furong Lab alumni class of ${year}`}>
            <div class="people-cohort-label">
              <strong>Class of {year}</strong>
              <span>{members.length} {members.length === 1 ? "alumnus" : "alumni"}</span>
            </div>
            <div class="people-grid alumni-grid">{members.map((person) => <PersonCard person={person} />)}</div>
          </section>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
