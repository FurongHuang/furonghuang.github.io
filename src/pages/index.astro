---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResearchMap from "../components/ResearchMap.astro";
import PaperCard from "../components/PaperCard.astro";
import SocialLinks from "../components/SocialLinks.astro";
import EmailReveal from "../components/EmailReveal.astro";
import PortraitImage from "../components/PortraitImage.astro";
import publicationData from "../data/publications.json";
import {
  affiliations,
  frontierPublicationTitles,
  impactPublicationTitles,
  news,
  profile,
  selectedRecognition
} from "../data/site";
import { alumni, currentPhdStudents } from "../data/people";

const works = publicationData.works as any[];
const worksFor = (titles: readonly string[]) => titles
  .map((title) => {
    const work = works.find((candidate) => candidate.title === title);
    if (!work) throw new Error(`Homepage selection not found in publications.json: ${title}`);
    return work;
  })
  .filter(Boolean);
const impactWorks = worksFor(impactPublicationTitles);
const frontierWorks = worksFor(frontierPublicationTitles);
const distinctWorkCount = works.length;
const selectedWorkSignificance: Record<string, string> = {
  "μ0: A Scalable 3D Interaction-Trace World Model": "Introduces interaction traces as a scalable representation for learning transferable 3D world models across embodiments.",
  "HumanEgo: Zero-Shot Robot Learning from Minutes of Human Egocentric Videos": "Shows that minutes of human egocentric video can support zero-shot robot behavior without robot-specific demonstrations.",
  "EgoScale: Scaling Dexterous Manipulation with Diverse Egocentric Human Data": "Scales dexterous manipulation by turning diverse human egocentric experience into transferable robot-learning signals.",
  "MomaGraph: State-Aware Unified Scene Graphs with Vision-Language Model for Embodied Task Planning": "Builds state-aware scene graphs that let embodied agents plan from vision-language representations of changing environments.",
  "SoTA with Less: MCTS-Guided Sample Selection for Data-Efficient Visual Reasoning Self-Improvement": "Uses search-guided sample selection to improve visual reasoning while requiring substantially less training data.",
  "Agentic Critical Training": "Treats agent improvement as a closed loop of proposing, criticizing, revising, and learning from trajectories.",
  "FlowBank: Query-Adaptive Agentic Workflows Optimization through Precompute-and-Reuse": "Optimizes agentic workflows by precomputing reusable reasoning structures and adapting them to each query.",
  "Escaping From Saddle Points - Online Stochastic Gradient for Tensor Decomposition": "Established efficient guarantees for escaping saddle points, connecting nonconvex optimization theory to practical learning.",
  "HallusionBench: An Advanced Diagnostic Suite for Entangled Language Hallucination & Visual Illusion in Large Vision-Language Models": "Separates visual illusion from language hallucination to diagnose where multimodal models actually fail.",
  "AutoDAN: Interpretable Gradient-Based Adversarial Attacks on Large Language Models": "Introduced an interpretable gradient-based framework for automatically constructing strong adversarial prompts against language models.",
  "TraceVLA: Visual Trace Prompting Enhances Spatial-Temporal Awareness for Generalist Robotic Policies": "Uses visual traces to give generalist robot policies stronger spatial-temporal awareness across tasks.",
  "Position: On the Possibilities of AI-Generated Text Detection": "Clarifies fundamental limits and realistic opportunities for detecting AI-generated text.",
  "WAVES: Benchmarking the Robustness of Image Watermarks": "Created a standardized stress-testing benchmark for comparing image-watermark robustness under diverse attacks.",
  "PropensityBench: Evaluating Latent Safety Risks in Large Language Models via an Agentic Approach": "Reveals latent safety risks through agentic evaluations that go beyond single-turn model testing."
};
const featuredAlumniNames = ["Bang An", "Sicheng Zhu", "Souradip Chakraborty", "Xiaoyu Liu", "Yuhang Zhou", "Yuancheng Xu"];
const featuredAlumni = featuredAlumniNames
  .map((name) => alumni.find((person) => person.name === name))
  .filter(Boolean);
const placementDestinations = ["OpenAI", "MIT CSAIL", "Google", "Meta", "Apple", "Netflix", "Yale", "Amazon", "Capital One", "APQX"];
const alumniDestinationCount = new Set(alumni.map((person) => person.destination?.split(" · ")[0]).filter(Boolean)).size;
---

<BaseLayout>
  <section class="shell hero">
    <div class="hero-copy">
      <p class="eyebrow">Trustworthy foundation models · University of Maryland</p>
      <h1>AI systems that <em>reason, act, recover,</em> and improve.</h1>
      <p class="hero-intro">
        Furong Huang's lab studies foundation models as decision-making systems—models that understand physical and digital worlds, reason under uncertainty, act through tools or bodies, and learn from failure.
      </p>
      <p class="hero-identity">{profile.title} · {profile.institution}</p>
      <SocialLinks />
      <div class="button-row">
        <a class="button" href="/research/">Explore the research <span>→</span></a>
        <a class="button secondary" href="/publications/">Browse publications</a>
      </div>
    </div>
    <div class="portrait-stage">
      <div class="portrait-frame">
        <img src="/assets/bodyshot.webp" alt="Furong Huang" width="1200" height="1600" fetchpriority="high" />
      </div>
      <div class="portrait-caption">
        <span>Research vision</span>
        <strong>Trust should be designed as a closed loop.</strong>
      </div>
    </div>
  </section>

  <section class="shell metrics-strip homepage-metrics" aria-label="Furong Lab at a glance">
    <div class="metric"><strong>{distinctWorkCount}</strong><span>Distinct scholarly works</span></div>
    <div class="metric"><strong>{currentPhdStudents.length}</strong><span>Current Ph.D. students</span></div>
    <div class="metric"><strong>{alumni.length}</strong><span>Doctoral alumni</span></div>
    <div class="metric"><strong>{alumniDestinationCount}</strong><span>Alumni destinations</span></div>
  </section>

  <section class="shell section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Research architecture</p>
        <h2>Three connected loops for capable and trustworthy AI.</h2>
      </div>
      <p>
        The lab connects models of the world, policies for allocating reasoning, and mechanisms that turn failures into safer future behavior.
      </p>
    </div>
    <ResearchMap />
  </section>

  <section class="shell section" id="selected-work">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2>A portfolio spanning foundational ideas, influential systems, and the current research frontier.</h2>
      </div>
      <p>
        Together, these projects trace the lab’s evolution—from foundational learning theory and widely used benchmarks to embodied intelligence, reasoning systems, and trustworthy AI.
      </p>
    </div>
    <div class="featured-work-group">
      <div class="featured-work-heading">
        <div><p class="eyebrow">Current research program</p><h3>Recent work that makes the lab’s vision concrete.</h3></div>
        <p>Recent projects spanning 3D world models, embodied planning, efficient visual reasoning, agentic workflows, and latent safety.</p>
      </div>
      <div class="paper-grid featured-paper-grid">
        {frontierWorks.map((paper) => <PaperCard paper={paper} significance={selectedWorkSignificance[paper.title]} />)}
      </div>
    </div>
    <div class="featured-work-group">
      <div class="featured-work-heading">
        <div><p class="eyebrow">Signature contributions</p><h3>Ideas and systems with lasting reach.</h3></div>
        <p>Foundational results, widely used benchmarks, and representative systems across optimization, multimodal intelligence, AI safety, robotics, and content provenance.</p>
      </div>
      <div class="paper-grid featured-paper-grid">
        {impactWorks.map((paper) => <PaperCard paper={paper} significance={selectedWorkSignificance[paper.title]} />)}
      </div>
    </div>
    <div class="button-row" style="margin-top: 2rem">
      <a class="button secondary" href="/publications/">View all {distinctWorkCount} distinct works <span>→</span></a>
    </div>
  </section>

  <section class="placement-band">
    <div class="shell placement-inner">
      <div class="placement-heading">
        <div>
          <p class="eyebrow">Where talent goes</p>
          <h2>The lab’s strongest record is its people.</h2>
        </div>
        <p>
          Furong Lab alumni carry their research into leading AI organizations, technology companies, and academic institutions. Their trajectories are part of the lab’s impact—not a footnote to it.
        </p>
      </div>
      <div class="destination-cloud" aria-label="Selected alumni destinations">
        {placementDestinations.map((destination) => <span>{destination}</span>)}
      </div>
      <div class="placement-people">
        {featuredAlumni.map((person) => person && (
          <a class="placement-person" href={person.href || "/people/"}>
            {person.image ? <PortraitImage src={person.image} alt={`Portrait of ${person.name}`} position={person.imagePosition} scale={person.imageScale} className="placement-photo" /> : <span class="placement-initials" aria-hidden="true">{person.name.split(" ").map((part) => part[0]).join("").slice(0, 2)}</span>}
            <span><strong>{person.name}</strong><small>{person.destination}</small></span>
          </a>
        ))}
      </div>
      <a class="placement-link" href="/people/#alumni">Meet the extended Furong Lab community <span>→</span></a>
    </div>
  </section>

  <section class="recognition-band">
    <div class="shell section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Selected recognition</p>
          <h2>Recognition for research that connects rigor with impact.</h2>
        </div>
        <p>
          Selected awards and grants from the{" "}
          <a class="inline-link" href="/Furong_Huang_CV.pdf">complete CV</a>.
        </p>
      </div>
      <div class="content-grid recognition-grid">
        {selectedRecognition.map((item) => (
          <article class="content-card recognition-card">
            <span>{item.year}</span>
            <h3>{item.title}</h3>
            <p>{item.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="shell section homepage-about">
    <div class="section-heading">
      <div>
        <p class="eyebrow">About Furong</p>
        <h2>Research leadership across machine learning, robotics, and trustworthy AI.</h2>
      </div>
      <p>
        Furong Huang is a tenured associate professor of computer science at the University of Maryland, building learning systems that connect mathematical foundations with consequential real-world behavior.
      </p>
    </div>
    <div class="content-grid">
      <article class="content-card">
        <p class="eyebrow">UMD affiliations</p>
        <h3>An interdisciplinary academic home.</h3>
        <div class="profile-link-list">
          {affiliations.map((affiliation) => <a href={affiliation.href}>{affiliation.label} <span>↗</span></a>)}
        </div>
      </article>
      <article class="content-card">
        <p class="eyebrow">Academic path</p>
        <h3>From learning theory to foundation-model systems.</h3>
        <p>
          Before joining UMD in 2017, Furong was a postdoctoral researcher at{" "}
          <a class="inline-link" href="https://www.microsoft.com/en-us/research/lab/microsoft-research-new-york/labs/">Microsoft Research New York City</a>,
          mentored by <a class="inline-link" href="https://www.microsoft.com/en-us/research/people/jcl/">John Langford</a> and{" "}
          <a class="inline-link" href="https://www.microsoft.com/en-us/research/people/schapire/">Robert Schapire</a>.
        </p>
        <p>
          She earned her Ph.D. with{" "}
          <a class="inline-link" href="https://www.cms.caltech.edu/people/anima">Anima Anandkumar</a>, working on high-dimensional learning and tensor methods.
        </p>
      </article>
      <article class="content-card">
        <p class="eyebrow">Research support</p>
        <h3>Public and industrial partners.</h3>
        <p>Research has been supported by NSF, DARPA, ONR, AFOSR, Good Ventures through Open Philanthropy, NVIDIA, Microsoft, Adobe, Apple, JP Morgan, Capital One, Amazon, and Peraton.</p>
        <a class="text-link" href="/cv/">See the complete record <span>→</span></a>
      </article>
    </div>
  </section>

  <section class="shell section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Latest signals</p>
        <h2>News from the lab.</h2>
      </div>
      <p>Recent talks, publications, student milestones, and recognition from across Furong Lab.</p>
    </div>
    <div class="news-grid">
      {news.slice(0, 3).map((item) => (
        <article class="news-card">
          <time>{item.date}</time>
          <span class="news-type">{item.type}</span>
          <h3>{item.title}</h3>
          <p>{item.detail}</p>
          {item.href && <a href={item.href}>Read more <span>↗</span></a>}
        </article>
      ))}
    </div>
    <div class="button-row" style="margin-top: 2rem"><a class="button secondary" href="/news/">See all news <span>→</span></a></div>
  </section>

  <section class="shell section">
    <div class="cta">
      <p class="eyebrow" style="color: white">Research with us</p>
      <h2>Build foundation models that can earn trust through their behavior.</h2>
      <p>Prospective students should review the Join page for current opportunities, research-fit guidance, and inquiry instructions before contacting Furong.</p>
      <div class="button-row">
        <a class="button" href="/join/">Read how to join <span>→</span></a>
        <a class="button" href="/people/">Meet the group</a>
        <EmailReveal inverted />
      </div>
    </div>
  </section>
</BaseLayout>
