---
import BaseLayout from "../layouts/BaseLayout.astro";
import CourseReadings from "../components/CourseReadings.astro";
import CourseProjects from "../components/CourseProjects.astro";
import projectCatalogue from "../data/cmsc848n-projects.json";
import { existsSync, readdirSync } from "node:fs";
import { resolve } from "node:path";

const slideRoot = "/courses/cmsc848n/fall-2026/slides";
const slideDirectory = resolve(process.cwd(), "public/courses/cmsc848n/fall-2026/slides");
const releasedSlides = new Set<string>(
  existsSync(slideDirectory)
    ? readdirSync(slideDirectory).filter((filename) => filename.toLowerCase().endsWith(".pdf"))
    : []
);

const getPublishedSlideFilename = (filename: string | null) => filename ? filename.replace(/\.pptx$/i, ".pdf") : "";

const courseDateFormatter = new Intl.DateTimeFormat("en-US", {
  timeZone: "UTC",
  weekday: "short",
  month: "short",
  day: "numeric"
});

const formatCourseDate = (date: string) => courseDateFormatter.format(new Date(`${date}T12:00:00Z`));
const canceledDates = new Set(["2026-10-29"]);
const todayEastern = new Intl.DateTimeFormat("en-CA", { timeZone: "America/New_York" }).format(new Date());
const formatReleaseDate = (date: string) => {
  const releaseDate = new Date(`${date}T12:00:00Z`);
  releaseDate.setUTCDate(releaseDate.getUTCDate() - 2);
  return courseDateFormatter.format(releaseDate);
};

interface CourseModule {
  number: string | null;
  module: string;
  outcome: string;
  lectures: [string, string, string | null][];
}

const modules: CourseModule[] = [
  {
    number: "01",
    module: "Agent-system foundations",
    outcome: "Define the complete agent system and reason about sequential experience.",
    lectures: [
      ["2026-09-01", "Agent Systems: The Model Is Not the Agent", "W1-L1-Agent-Systems-The-Model-Is-Not-the-Agent.pptx"],
      ["2026-09-03", "Reinforcement Learning for Generative Agents", "W1-L2-2026-Reinforcement-Learning-for-Generative-Agents.pptx"]
    ]
  },
  {
    number: "02",
    module: "Reinforcement learning foundations",
    outcome: "Complete the reinforcement-learning foundations needed for later agent training.",
    lectures: [
      ["2026-09-08", "Reinforcement Learning for Generative Agents (continued)", null],
      ["2026-09-10", "Reinforcement Learning for Generative Agents (continued)", null]
    ]
  },
  {
    number: "03",
    module: "GRPO and alignment",
    outcome: "Connect group-relative reinforcement learning with preference optimization and controlled decoding.",
    lectures: [
      ["2026-09-15", "DeepSeek-R1, GRPO, and Agentic Reinforcement Learning", "W3-L1-2026-DeepSeek-R1-GRPO-and-Agentic-RL.pptx"],
      ["2026-09-17", "Alignment from DPO to Controlled Decoding", "W3-L2-2026-Alignment-DPO-to-Controlled-Decoding.pptx"]
    ]
  },
  {
    number: "04",
    module: "Alignment continuation and planning",
    outcome: "Complete the alignment material, then study planning and state.",
    lectures: [
      ["2026-09-22", "Alignment from DPO to Controlled Decoding (continued)", "W3-L2-2026-Alignment-DPO-to-Controlled-Decoding.pdf"],
      ["2026-09-24", "Planning and State", "W4-L1-2026-Planning-and-State.pdf"]
    ]
  },
  {
    number: "05",
    module: "Agent harnesses, memory, and tool use",
    outcome: "Study how the harness selects context, maintains memory, and executes tool calls.",
    lectures: [
      ["2026-09-29", "Memory and Context Engineering", "W5-L1-2026-Memory-and-Context-Engineering.pdf"],
      ["2026-10-01", "Tool Use and Action Interfaces", "W5-L2-2026-Tool-Use-and-Action-Interfaces.pdf"]
    ]
  },
  {
    number: "06",
    module: "Durable composition",
    outcome: "Compose agents into workflows and justified multi-agent teams.",
    lectures: [
      ["2026-10-06", "Agentic Workflows and Orchestration", "W6-L1-2026-Agentic-Workflows-and-Orchestration-v6.pdf"],
      ["2026-10-08", "Multi-Agent Systems", "W6-L2-2026-Multi-Agent-Systems-v7.pdf"]
    ]
  },
  {
    number: "07",
    module: "Inside a coding-agent harness",
    outcome: "Follow a real repair and explain how the harness shapes actions, feedback, and verification.",
    lectures: [
      ["2026-10-15", "Inside a Coding-Agent Harness", "W7-L1-2026-Inside-a-Coding-Agent-Harness.pdf"]
    ]
  },
  {
    number: "08",
    module: "Training coding agents and improving their harnesses",
    outcome: "Learn from repair trajectories, then test changes to the runtime around a fixed model.",
    lectures: [
      ["2026-10-20", "Training Coding Agents", "W8-L1-2026-Training-Coding-Agents.pdf"],
      ["2026-10-22", "Optimizing Coding-Agent Harnesses", "W8-L2-2026-Optimizing-Coding-Agent-Harnesses.pdf"]
    ]
  },
  {
    number: "09",
    module: "Research and scientific agents",
    outcome: "Connect sources, claims, hypotheses, experiments, and qualified conclusions.",
    lectures: [
      ["2026-10-27", "Deep Research Agents: Search, Evidence, and Reproducible Synthesis", "W9-L1-2026-Deep-Research-Agents.pdf"],
      ["2026-10-29", "Scientific Discovery Agents: Hypotheses, Experiments, and Valid Claims", "W9-L2-2026-Scientific-Discovery-Agents.pdf"]
    ]
  },
  {
    number: "10",
    module: "Embodied agents and robotics",
    outcome: "Design and evaluate closed-loop world-model and vision-language-action agents.",
    lectures: [
      ["2026-11-03", "World Models and Vision-Language-Action Agents", "W10-L1-2026-Foundation-Models-for-Robotics.pdf"],
      ["2026-11-05", "Data-Efficient Embodied Learning and Evaluation", "W10-L2-2026-Data-Efficient-Embodied-Learning-and-Evaluation.pdf"]
    ]
  },
  {
    number: "11",
    module: "Agent robustness and safety",
    outcome: "Threat-model the lifecycle and plan prevention, monitoring, and recovery.",
    lectures: [
      ["2026-11-10", "Adversarial Threats Across the Agent Lifecycle", "W11-L1-Adversarial-Threats-Across-the-Agent-Lifecycle.pdf"],
      ["2026-11-12", "Defense in Depth, Monitoring, and Incident Response", "W11-L2-2026-Defense-in-Depth-Paper-Figures-v6.pdf"]
    ]
  },
  {
    number: "12",
    module: "Learning from experience and self-improvement",
    outcome: "Govern persistent adaptation with evaluation, lineage, retention, and rollback.",
    lectures: [
      ["2026-11-17", "Learning from Experience: Prompts, Skills, Policies, and Continual Adaptation", "W12-L1-2026-Learning-from-Experience.pdf"],
      ["2026-11-19", "Self-Modifying and Evolutionary Agents", "W12-L2-2026-Self-Modifying-and-Evolutionary-Agents.pdf"]
    ]
  },
  {
    number: "13",
    module: "Evaluation, provenance, and synthesis",
    outcome: "Make deployment decisions from reproducible evidence and accountable provenance.",
    lectures: [
      ["2026-11-24", "Agent Evaluation and Deployment Evidence", "W13-L1-2026-Agent-Evaluation-and-Deployment-Evidence.pdf"],
      ["2026-12-01", "Provenance, Watermarking, and Frontier Challenges", "W13-L2-2026-Provenance-Watermarking-and-Frontier-Challenges.pdf"]
    ]
  },
  {
    number: null,
    module: "December 3 Q&A session",
    outcome: "Open question-and-answer session. Bring your questions.",
    lectures: [
      ["2026-12-03", "Open Q&A session", null]
    ]
  }
];

const assessments = [
  ["10%", "In-class quizzes", "Impromptu short quizzes during lectures.", "Sep 1–Dec 3"],
  ["20%", "Homework", "Three assignments covering the course material.", "Sep 30 · Oct 30 · Nov 30"],
  ["30%", "Midterm report", "Project progress, a literature review, and baseline results.", "Oct 15"],
  ["20%", "Final presentation", "A concise presentation of the project, results, and limitations.", "Dec 8 & 10"],
  ["20%", "Final report and artifacts", "A research or engineering report, runnable code, and supporting evidence.", "Dec 11"]
];

const projectRubrics = [
  {
    "title": "Midterm package",
    "weight": "30% of course grade",
    "rows": [
      [
        "Problem and scope",
        20,
        "A precise question or use case, motivated by a concrete limitation; clearly defined success criteria and a feasible semester scope."
      ],
      [
        "Related work and baseline",
        25,
        "Accurate discussion of the closest approaches, verified citations, and a runnable baseline appropriate to the question."
      ],
      [
        "Preliminary evidence",
        30,
        "An end-to-end experiment or prototype, interpretable measurements, and an analysis of failures and uncertainty."
      ],
      [
        "Evaluation plan and milestones",
        25,
        "Held-out tasks, meaningful metrics, fair comparisons, resource budgets, major risks, and a credible plan for the remaining work."
      ]
    ]
  },
  {
    "title": "Final presentation",
    "weight": "20% of course grade",
    "rows": [
      [
        "Problem and approach",
        20,
        "Clear motivation, necessary background, and an understandable explanation of the technical choices."
      ],
      [
        "Evidence and interpretation",
        40,
        "Results against appropriate baselines, readable figures, and conclusions supported by measurements. A demo supplements the evidence."
      ],
      [
        "Limitations and discussion",
        20,
        "Thoughtful treatment of failure cases, alternative explanations, uncertainty, and questions from the audience."
      ],
      [
        "Communication and contributions",
        20,
        "A coherent presentation within the allotted time, legible slides, and clearly identified contributions from each team member."
      ]
    ]
  },
  {
    "title": "Final artifacts: research track",
    "weight": "20% of course grade",
    "rows": [
      [
        "Research question and contribution",
        20,
        "A precise hypothesis and a clear account of what the work adds relative to the closest prior work."
      ],
      [
        "Experimental rigor",
        35,
        "Strong baselines, controlled comparisons, relevant ablations, held-out evaluation, and uncertainty estimates where appropriate."
      ],
      [
        "Technical correctness and analysis",
        25,
        "Correct methods and mathematics, defensible conclusions, and substantive analysis of failures and competing explanations."
      ],
      [
        "Reproducibility and reporting",
        20,
        "A clear paper-style report, runnable code, documented configurations and dependencies, and sufficient details to reproduce the main results."
      ]
    ]
  },
  {
    "title": "Final artifacts: engineering track",
    "weight": "20% of course grade",
    "rows": [
      [
        "Correctness and reliability",
        35,
        "An end-to-end system meeting agreed requirements, with automated tests, failure handling, and appropriate security and privacy protections."
      ],
      [
        "Evaluation",
        25,
        "Comparison with a simple baseline under documented workloads, measuring relevant quality, latency, cost, or usability outcomes."
      ],
      [
        "System design",
        20,
        "Well-justified interfaces and architectural choices, explicit tradeoffs, and a maintainable implementation."
      ],
      [
        "Reproducibility and documentation",
        20,
        "Reliable setup instructions, a repeatable demo, test commands, configurations, and clearly documented limitations."
      ]
    ]
  }
];

const milestones = [
  ["Initial planning", "Project scope and baseline", "Agree on the research question, team, benchmark or environment, and a runnable baseline."],
  ["Oct 15", "Midterm report", "Report preliminary results, related work, failure cases, and a plan for the remaining work."],
  ["Before final evaluation", "Freeze evaluation", "Lock held-out tasks, metrics, budgets, and contamination controls."],
  ["Before submission", "Artifact audit", "Check reproducibility, regressions, security, and the evidence supporting each claim."],
  ["Dec 8 & 10", "Final presentations", "Present the problem, approach, results, limitations, and individual contributions."],
  ["Dec 11", "Final report and artifacts", "Submit the paper-style report, runnable code, and supporting evidence."]
];

const projectBriefFields = [
  ["01", "Motivation & gap", "Why the problem matters and what unresolved gap makes it worth pursuing."],
  ["02", "Question & novelty", "A concrete research question and the seed of a new, defensible contribution."],
  ["03", "Closest prior work", "Starting references, relevant systems, and the work a new result must improve upon."],
  ["04", "Research hypothesis", "A technically credible first route, with space for the team to develop its own approach."],
  ["05", "Data & baselines", "Datasets, environments, comparison points, and practical starting assets."],
  ["06", "Conference-level evidence", "Metrics, budgets, strong baselines, ablations, and failure analyses for a valid claim."],
  ["07", "Research artifacts", "A conference-style paper, reproducible code, evidence, and a concise presentation."]
];


const prerequisiteReadings = [
  ["Mathematics for Machine Learning (Math4ML)", "Calculus & linear algebra", "https://users.umiacs.umd.edu/~hal3/courses/2013S_ML/math4ml.pdf"],
  ["Linear Algebra Review", "Calculus & linear algebra", "https://www.cs.umd.edu/class/fall2019/cmsc726/materials/linear-algebra-review.pdf"],
  ["Advanced Linear Algebra Review", "Calculus & linear algebra", "https://www.cs.umd.edu/~tomg/course/cmsc764/L1_linalg_review.pdf"],
  ["Convex Analysis Review", "Optimization", "https://www.cs.umd.edu/class/fall2019/cmsc726/materials/convex-review.pdf"],
  ["Optimization Review", "Optimization", "https://www.cs.umd.edu/~tomg/course/cmsc764/L3_optimization_problems_overview.pdf"],
  ["Probability Review", "Probability & statistics", "https://www.cs.umd.edu/class/fall2019/cmsc726/materials/prob-review.pdf"]
];

---

<BaseLayout
  title="CMSC 848N — Generative AI Agents · Fall 2026"
  hidePersonalContact
  description="Fall 2026 at the University of Maryland: foundations and frontiers of generative AI agents."
  image="/courses/cmsc848n/fall-2026/og.png"
  imageAlt="CMSC 848N Generative AI Agents · Fall 2026 · University of Maryland"
>
  <section class="shell course-hero">
    <div class="course-hero-copy">
      <p class="eyebrow">Fall 2026 · CMSC 848N · University of Maryland</p>
      <h1>Generative<br /><em>AI Agents</em></h1>
      <p class="course-lede">
        Foundations and frontiers of systems that reason, plan, act, use tools, and adapt in complex environments.
      </p>
      <div class="button-row">
        <a class="button" href="#schedule">View schedule <span aria-hidden="true">↓</span></a>
        <a class="button secondary" href="#projects">Explore projects <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <aside class="course-at-a-glance" aria-label="Course at a glance">
      <p class="eyebrow">At a glance</p>
      <div><strong>15</strong><span>semester weeks</span></div>
      <div><strong>{modules.filter(module => module.number).length}</strong><span>teaching modules</span></div>
      <div><strong>{projectCatalogue.projects.length}</strong><span>personalized research projects</span></div>
      <p>Tuesdays & Thursdays · 11:00 a.m.–12:15 p.m. · CSI 3117</p>
    </aside>
  </section>

  <nav class="shell course-quick-links" aria-label="Course shortcuts">
    <a href="#overview"><span>01</span> Overview</a>
    <a href="#schedule"><span>02</span> Schedule & slides</a>
    <a href="#readings"><span>03</span> Pre-class readings</a>
    <a href="#projects"><span>04</span> Projects</a>
    <a href="#policies"><span>05</span> Policies</a>
  </nav>

  <section id="overview" class="shell section course-overview">
    <div class="course-section-heading">
      <div>
        <p class="eyebrow">The course</p>
        <h2>Build agents whose claims can survive contact with the world.</h2>
      </div>
      <div>
        <p>
          An agent is more than a model. It is a governed sequential decision system: model, controller, environment, state and memory, tools and protocols, authority policy, evaluator, and people.
        </p>
        <p>
          We will connect theoretical foundations to modern practice, with an emphasis on algorithmic building blocks, valid evaluation, and open research problems.
        </p>
      </div>
    </div>

    <div class="course-facts">
      <article>
        <span>Course team</span>
        <strong>Prof. Furong Huang</strong>
        <p>Instructors (TAs)</p>
        <div class="course-ta-list" aria-label="Instructors (TAs)">
          <div class="course-ta-person">
            <div class="course-ta-avatar" aria-hidden="true">YP</div>
            <b>
              <a class="course-ta-profile" href="https://www.linkedin.com/in/yucheng-pan-410a422a2/" target="_blank" rel="noopener noreferrer" aria-label="Yucheng Pan on LinkedIn (opens in a new tab)">Yucheng Pan <i aria-hidden="true">↗</i></a>
              <a class="course-ta-email" href="mailto:ycpan@umd.edu">ycpan@umd.edu</a>
            </b>
          </div>
          <div class="course-ta-person">
            <img src="/assets/people/yijun-liang.jpg" alt="Yijun Liang" width="48" height="48" loading="lazy" decoding="async" />
            <b>Yijun Liang<br /><a class="course-ta-email" href="mailto:yliang17@umd.edu">yliang17@umd.edu</a></b>
          </div>
          <div class="course-ta-person">
            <img src="/assets/people/taewon-kang.jpg" alt="Taewon Kang" width="48" height="48" loading="lazy" decoding="async" />
            <b>
              <a class="course-ta-profile" href="https://www.cs.umd.edu/people/taewon" target="_blank" rel="noopener noreferrer" aria-label="Taewon Kang's UMD profile (opens in a new tab)">Taewon Kang <i aria-hidden="true">↗</i></a>
              <a class="course-ta-email" href="mailto:taewon@umd.edu">taewon@umd.edu</a>
            </b>
          </div>
        </div>
      </article>
      <article><span>Meetings</span><strong>Tue & Thu · 11:00–12:15</strong><p>CSI 3117 · America/New_York</p></article>
      <article><span>Prerequisites</span><strong>ML + deep learning</strong><p>Probability, optimization, linear algebra, and Python</p></article>
      <article><span>Coursework</span><strong>Evidence over demos</strong><p>Diagnosis, implementation, and one personalized research project</p></article>
      <article><span>Expected workload</span><strong>8–12 hours per week</strong><p>Readings, homework, experiments, and team research</p></article>
      <article><span>Communication</span><strong>ELMS + course Slack</strong><p>Course links and office hours will be shared through ELMS and course Slack</p></article>
    </div>
  </section>

  <section id="schedule" class="course-band">
    <div class="shell section">
      <div class="course-section-heading compact">
        <div><p class="eyebrow">Schedule & slides</p><h2>Thirteen modules.</h2></div>
        <p>Fall classes run August 31–December 11. CMSC 848N meets September 1–December 10. Available slide PDFs are linked below; the scheduled release is two days before each lecture. Dates follow the <a href="https://academiccatalog.umd.edu/about-university/academic-calendar/semester-calendar/semester-calendar.pdf">official UMD semester calendar</a>.</p>
      </div>

      <p>No class Tuesday, October 13 (Fall Break). W7-L1 meets Thursday, October 15.</p>
      <p>The October 29 lecture was canceled; its PDF and readings are available for independent study. End-of-semester meetings: November 24 and December 1 lectures, December 3 open Q&A, and December 8 & 10 project presentations. No class November 26 (Thanksgiving Recess).</p>

      <ol class="course-schedule">
        {modules.map(({ number, module, outcome, lectures }) => (
          <li>
            <div class="week-number"><span>{number ? "Module" : "Q&A"}</span><strong>{number ?? "—"}</strong></div>
            <div class="week-topic">
              <h3>{module}</h3><p>{outcome}</p>
              {number === "08" && <a class="lecture-reading-link" href={`${slideRoot}/coding-agents-sources-and-reuse.md`}>Sources and reuse notices for the three coding-agent lectures</a>}
              {number === "09" && <a class="lecture-reading-link" href={`${slideRoot}/reuse-notices/W9-L2-sources-and-reuse.md`}>Sources and figure reuse for the scientific discovery slides</a>}
              {number === "13" && <a class="lecture-reading-link" href={`${slideRoot}/reuse-notices/W13-L1-reused-figures.md`}>Reused figures in the agent evaluation lecture</a>}
              {number === "13" && <a class="lecture-reading-link" href={`${slideRoot}/reuse-notices/W13-L2-reused-figures.md`}>Reused figures in the provenance and watermarking lecture</a>}
            </div>
            <div class="week-lectures">
              {lectures.map(([date, title, file], index) => (
                <div class="lecture-session">
                  {releasedSlides.has(getPublishedSlideFilename(file)) ? (
                    <a class="lecture-item" href={`${slideRoot}/${getPublishedSlideFilename(file)}`} download>
                      <div class="lecture-meta"><span>{number ? `L${index + 1}` : "Q&A"}</span><time datetime={date}>{formatCourseDate(date)}</time></div>
                      <strong>{title}</strong>
                      <small>PDF ↓</small>
                    </a>
                  ) : (
                    <div class="lecture-item is-pending">
                      <div class="lecture-meta"><span>{number ? `L${index + 1}` : "Q&A"}</span><time datetime={date}>{formatCourseDate(date)}</time></div>
                      <strong>{title}</strong>
                      <small>{file ? (date < todayEastern ? "PDF not yet posted" : `Planned PDF release: ${formatReleaseDate(date)} · 11 AM`) : number ? "Continued from prior lecture" : "No slides or pre-class reading"}</small>
                    </div>
                  )}
                  {number ? <a class="lecture-reading-link" href={`#reading-${date}`} aria-label={`${canceledDates.has(date) ? "Independent" : "Pre-class"} reading for ${formatCourseDate(date)}: ${title}`}>{canceledDates.has(date) ? "Independent reading →" : "Pre-class reading →"}</a> : <span class="lecture-reading-link">No pre-class reading assigned</span>}
                </div>
              ))}
            </div>
          </li>
        ))}
      </ol>

      <div class="calendar-markers" aria-label="Fall 2026 schedule exceptions and final meetings">
        <article><span>No class</span><strong>Tue · Oct 13</strong><p>UMD Fall Break</p></article>
        <article><span>No class</span><strong>Thu · Nov 26</strong><p>UMD Thanksgiving Recess</p></article>
        <article><span>Final meetings</span><strong>Dec 8 & 10 · 11:00 AM</strong><p>Personalized research project presentations</p></article>
      </div>
    </div>
  </section>

  <CourseReadings lectures={modules.flatMap(({ number, lectures }) =>
    lectures.map(([date, title], index) => ({ date, title, module: number, lecture: index + 1, canceled: canceledDates.has(date) }))
  )} />

  <section id="projects" class="shell section projects-section">
    <div class="course-section-heading">
      <div><p class="eyebrow">Personalized research project</p><h2>Research projects.</h2></div>
      <div>
        <p>Explore the 27 instructor-designed research projects, with motivations, technical questions, first experiments, and starting references. The full catalogue is now public; signup labels show what is recorded in the course signup sheet.</p>
      </div>
    </div>

    <p class="project-progress-note">Project work is underway. Use your agreed scope and the <a href="#project-rubrics">grading rubrics</a> to prepare for final presentations on December 8 & 10 and the final report on December 11. Discuss material changes with the instructors through ELMS or course Slack.</p>

    <CourseProjects />

    <p class="eyebrow">What each research project description includes</p>
    <div class="project-directions" aria-label="Information included in each project candidate">
      {projectBriefFields.map(([number, title, detail]) => (
        <article><span>{number}</span><h3>{title}</h3><p>{detail}</p></article>
      ))}
    </div>

    <div class="milestone-section">
      <p class="eyebrow">Project workflow and deadlines</p>
      <ol class="milestone-list">
        {milestones.map(([when, title, detail]) => (
          <li><span>{when}</span><strong>{title}</strong><p>{detail}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="course-band assessment-band">
    <div class="shell section">
      <div class="course-section-heading compact">
        <div><p class="eyebrow">Assessment</p><h2>How your work will be assessed.</h2></div>
        <p>The listed assessment weights and deadlines are shown below. Check ELMS for the official Fall 2026 syllabus, assignment instructions, and any announced changes.</p>
      </div>
      <div class="assessment-grid">
        {assessments.map(([weight, title, detail, due]) => (
          <article><strong>{weight}</strong><h3>{title}</h3><p>{detail}</p><small>{due}</small></article>
        ))}
      </div>
      <p><a href="#project-rubrics">Project grading rubrics and submission requirements ↓</a></p>
    </div>
  </section>

  <section id="project-rubrics" class="shell section">
    <div class="course-section-heading compact">
      <div><p class="eyebrow">Project assessment</p><h2>Project grading rubrics.</h2></div>
      <p>Research and engineering tracks share expectations for technical depth, sound evaluation, and reproducibility. Follow the official syllabus and assignment instructions in ELMS if they differ from this page.</p>
    </div>
    <p>Teams select a track and agree on scope with the instructor at the proposal milestone. Hybrid projects use one agreed rubric. The midterm package corresponds to the midterm report; final artifacts include the final report and supporting materials.</p>
    <p>Each table totals 100 points within its component. The two final-artifact rubrics are alternatives. In-class quizzes (10%) and homework (20%) remain separate assessments.</p>
    {projectRubrics.map(({ title, weight, rows }) => (
      <div class="project-rubric">
        <h3>{title}</h3>
        <p>{weight}</p>
        <div class="rubric-table-scroll" role="region" aria-label={title} tabindex="0">
          <table>
            <caption>{title}: 100 points</caption>
            <thead><tr><th scope="col">Criterion</th><th scope="col">Points</th><th scope="col">What earns full credit</th></tr></thead>
            <tbody>{rows.map(([criterion, points, description]) => (
              <tr><th scope="row">{criterion}</th><td>{points}</td><td>{description}</td></tr>
            ))}</tbody>
          </table>
        </div>
      </div>
    ))}
    <div class="project-rubric">
      <h3>What to submit</h3>
      <ul>
        <li><strong>Midterm:</strong> a short report, runnable code, preliminary results, and an updated experimental plan.</li>
        <li><strong>Final presentation:</strong> slides explaining the problem, approach, results, limitations, and individual contributions.</li>
        <li><strong>Final artifacts:</strong> the research or engineering report, code, setup and evaluation commands, configurations, and supporting evidence. Engineering submissions also include automated tests and a repeatable demo.</li>
      </ul>
      <h3>Scoring and fairness</h3>
      <p>Score each criterion on a 0–4 scale, allowing half-points: <strong>4</strong> fully meets the criterion with convincing evidence; <strong>3</strong> largely meets it with minor gaps; <strong>2</strong> partially meets it with substantial gaps; <strong>1</strong> shows limited progress; <strong>0</strong> is missing or not assessable.</p>
      <p>Criterion points = allocated points × score ÷ 4. For example, 80/100 on final artifacts contributes 16 of the 20 available course points.</p>
      <ul>
        <li>Negative results can earn full credit when the investigation is rigorous and informative.</li>
        <li>Conference acceptance, a novel algorithm, expensive compute, and positive results are not grading requirements.</li>
        <li>Compare methods under fair resource budgets and explain unavoidable differences.</li>
        <li>Disclose reused code, datasets, assets, AI assistance, and each member’s contributions.</li>
        <li>Use synthetic or approved data for privacy-sensitive projects. Physical experiments require appropriate safety controls.</li>
        <li>Agree on material scope changes before final evaluation.</li>
        <li>Shared artifacts receive a team grade. Individual adjustments require documented contributions and demonstrated understanding, with an opportunity to clarify discrepancies.</li>
      </ul>
    </div>
  </section>

  <section id="resources" class="shell section resources-section">
    <div class="course-section-heading compact">
      <div><p class="eyebrow">Mathematical prerequisites</p><h2>Review the foundations.</h2></div>
      <p>Use these reviews throughout the semester. For the papers assigned to individual lectures, see the <a href="#readings">pre-class reading list</a>.</p>
    </div>
    <div class="resource-group-heading">
      <div><p class="eyebrow">Mathematical background</p><h3>Revisit the mathematics throughout the course.</h3></div>
      <p>Review the topics you need before working through the reinforcement-learning definitions, Bellman equations, and policy-improvement derivations.</p>
    </div>
    <div class="reference-list prerequisite-list">
      {prerequisiteReadings.map(([title, topic, url], index) => (
        <a href={url}>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <strong>{title}</strong>
          <small><b>Prerequisite</b> · {topic}<br />PDF</small>
          <i aria-hidden="true">↗</i>
        </a>
      ))}
    </div>
  </section>

  <section id="policies" class="shell section policies-section">
    <div class="course-section-heading compact">
      <div><p class="eyebrow">Course policies</p><h2>Expectations and support.</h2></div>
      <p>The official Fall 2026 syllabus and announcements in ELMS take precedence where they differ from this page. Students are responsible for reviewing <a href="https://www.ugst.umd.edu/courserelatedpolicies.html">UMD’s course-related policies and resources</a>.</p>
    </div>
    <div class="policy-grid">
      <article><h3>Teams & collaboration</h3><p>Projects use teams of up to three students. Record individual contributions in the midterm and final reports. A self-proposed topic requires written instructor approval; individual quizzes and other designated individual work must be completed independently.</p></article>
      <article><h3>Generative AI use</h3><p>AI tools may be used only when an assignment permits them. Disclose the model and version, preserve material prompts and tool traces, describe substantive edits, and verify every claim. AI assistance is not permitted on in-class quizzes unless explicitly stated.</p></article>
      <article><h3>Academic integrity</h3><p>Follow the UMD Code of Academic Integrity and Honor Pledge. Cite external code, models, datasets, papers, prompts, and tools. Do not copy or distribute solutions, fabricate evidence, or present another person’s or system’s work as your own.</p></article>
      <article><h3>Late work</h3><p>A shared 72-hour late bank applies across homework and written reports. It does not apply to quizzes, live presentations, or other in-person assessments. Once the bank is exhausted, late work is accepted only through an approved accommodation or excused-absence process.</p></article>
      <article><h3>Attendance & absences</h3><p>Regular attendance and active participation are expected. Report known absences before the schedule-adjustment deadline and unexpected absences as soon as possible through a private ELMS or course-Slack message. Do not post medical documentation publicly.</p></article>
      <article><h3>Responsible experimentation</h3><p>Use least privilege, sandbox side effects, protect private data, and obtain approval before tests that touch people or external systems. Human-subject research requires appropriate approval before data collection; consequential actions require monitoring and rollback ownership.</p></article>
      <article><h3>Accessibility & support</h3><p>Students who need accommodations should contact the University’s accessibility service and the instructor early. Please raise barriers to course materials, assessments, or participation as soon as possible so arrangements can be made.</p></article>
      <article><h3>Communication & continuity</h3><p>ELMS is the official source for announcements, assignments, grades, and urgent changes; course Slack supports discussion and help. If campus operations are interrupted, the continuation plan and any deadline changes will be announced through ELMS.</p></article>
    </div>
    <p class="course-revision">Course page updated November 24, 2026: schedule notes, reading labels, final-project deadlines, and public project catalogue. Check ELMS for official course announcements.</p>
  </section>

  <section class="shell course-final-cta">
    <p class="eyebrow">CMSC 848N · Fall 2026</p>
    <h2>Models speak. Agents change state.</h2>
    <p>Our job is to understand the system in between—and demand evidence for what it can safely do.</p>
    <div class="button-row">
      <a class="button" href="#schedule">View slide schedule ↓</a>
      <a class="button secondary" href="#projects">View project plan ↑</a>
    </div>
  </section>
</BaseLayout>



