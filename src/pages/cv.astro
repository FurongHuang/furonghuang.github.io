---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Curriculum Vitae — Furong Huang">
  <section class="shell page-hero">
    <p class="eyebrow">Curriculum vitae</p>
    <h1>The latest full CV, always at one stable address.</h1>
    <p>The PDF below is synchronized from the CV repository during the website update workflow.</p>
    <div class="button-row"><a class="button" href="/Furong_Huang_CV.pdf">Download the full CV <span>↗</span></a></div>
  </section>
  <section class="shell section" style="padding-top: 0">
    <iframe class="pdf-frame" src="/Furong_Huang_CV.pdf" title="Furong Huang full curriculum vitae"></iframe>
  </section>
</BaseLayout>
