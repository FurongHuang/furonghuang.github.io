---
const { inverted = false } = Astro.props as { inverted?: boolean };
---

<div class:list={["email-challenge", { inverted }]} data-email-challenge>
  <button class="email-start" type="button" aria-expanded="false">Contact Furong</button>
  <div class="email-question" hidden>
    <span>Quick human check: how many research pillars does Furong Lab have?</span>
    <div role="group" aria-label="Choose the number of research pillars">
      {[2, 3, 4].map((number) => <button type="button" data-answer={number}>{number}</button>)}
    </div>
    <small aria-live="polite"></small>
  </div>
</div>

<script>
  const encoded = [113, 107, 87, 67, 93, 93, 41, 8, 58, 59, 57, 74, 14, 22, 12];
  const address = () => String.fromCharCode(...encoded.map((value, index) => value ^ (23 + index * 7)));

  const renderAddress = (email: string) => {
    const width = 246;
    const height = 54;
    const scale = Math.min(window.devicePixelRatio || 1, 2);
    const canvas = document.createElement("canvas");
    canvas.className = "email-image";
    canvas.width = width * scale;
    canvas.height = height * scale;
    canvas.style.width = `${width}px`;
    canvas.style.height = `${height}px`;
    canvas.setAttribute("role", "img");
    canvas.setAttribute("aria-label", "Email address shown as an image to discourage automated harvesting");

    const context = canvas.getContext("2d");
    if (!context) return canvas;
    context.scale(scale, scale);
    context.fillStyle = "#fffdf8";
    context.fillRect(0, 0, width, height);

    context.strokeStyle = "rgba(19, 37, 53, 0.09)";
    context.lineWidth = 1;
    for (let line = 0; line < 7; line += 1) {
      context.beginPath();
      context.moveTo(Math.random() * width, Math.random() * height);
      context.lineTo(Math.random() * width, Math.random() * height);
      context.stroke();
    }

    context.fillStyle = "#132535";
    context.font = "600 18px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace";
    context.textBaseline = "middle";
    const characterWidth = 13.4;
    const startX = (width - email.length * characterWidth) / 2;
    [...email].forEach((character, index) => {
      context.save();
      context.translate(startX + index * characterWidth, height / 2 + (Math.random() - 0.5) * 2.5);
      context.rotate((Math.random() - 0.5) * 0.045);
      context.fillText(character, 0, 0);
      context.restore();
    });

    canvas.addEventListener("contextmenu", (event) => event.preventDefault());
    return canvas;
  };

  for (const challenge of document.querySelectorAll<HTMLElement>("[data-email-challenge]")) {
    const start = challenge.querySelector<HTMLButtonElement>(".email-start");
    const question = challenge.querySelector<HTMLElement>(".email-question");
    const status = challenge.querySelector<HTMLElement>("small");

    start?.addEventListener("click", () => {
      if (!question) return;
      question.hidden = false;
      start.setAttribute("aria-expanded", "true");
      start.hidden = true;
      question.querySelector<HTMLButtonElement>("button")?.focus();
    });

    for (const answer of challenge.querySelectorAll<HTMLButtonElement>("[data-answer]")) {
      answer.addEventListener("click", () => {
        if (answer.dataset.answer !== "3") {
          if (status) status.textContent = "Not quite—look at the research map above.";
          return;
        }
        const email = address();
        if (question) {
          question.innerHTML = "";
          const heading = document.createElement("span");
          heading.textContent = "Furong's email address";
          const image = renderAddress(email);
          const note = document.createElement("small");
          note.className = "email-instruction";
          note.textContent = "Please type this address into your email app.";
          question.append(heading, image, note);
        }
      });
    }
  }
</script>
