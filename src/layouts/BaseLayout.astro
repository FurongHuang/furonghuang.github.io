---
import "../styles/global.css";
import { profile } from "../data/site";
import SocialLinks from "../components/SocialLinks.astro";
import EmailReveal from "../components/EmailReveal.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = "Furong Huang — Trustworthy Foundation Models",
  description = "Furong Huang leads research on world models, reasoning control, and trustworthy self-improvement for foundation models.",
  image = "/assets/bodyshot.webp",
  noindex = false
} = Astro.props;

const pathname = Astro.url.pathname;
const siteUrl = Astro.site || new URL("https://furong-huang.com");
const canonicalUrl = new URL(pathname, siteUrl);
const socialImageUrl = new URL(image, siteUrl);
const pageType = pathname.startsWith("/blog/") && pathname !== "/blog/" ? "article" : "website";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  url: new URL("/", siteUrl).href,
  image: new URL("/assets/bodyshot.webp", siteUrl).href,
  jobTitle: profile.title,
  affiliation: {
    "@type": "CollegeOrUniversity",
    name: profile.institution,
    url: "https://www.umd.edu/"
  },
  sameAs: [profile.scholar, profile.x, profile.linkedin, profile.youtube, profile.github, profile.huggingface]
};
const desktopLinks = [
  ["/", "Home"],
  ["/research/", "Research"],
  ["/publications/", "Publications"],
  ["/people/", "People"],
  ["/news/", "News"],
  ["/blog/", "Blog"],
  ["/teaching/", "Teaching"],
  ["/cv/", "CV"]
];
const mobileLinks = [...desktopLinks, ["/join/", "Join"]];
const researchSubnav = [
  ["/research/", "Overview", "overview"],
  ["/research/#world-models", "World models", "world-models"],
  ["/research/#reasoning-control", "Reasoning control", "reasoning-control"],
  ["/research/#self-improvement", "Trustworthy self-improvement", "self-improvement"],
  ["/benchmarks/", "Benchmarks & evaluation", "benchmarks"]
];
const showResearchSubnav = pathname.startsWith("/research/") || pathname.startsWith("/benchmarks/");
const researchSectionByPath: Record<string, string> = {
  "/research/embodied-ai/": "world-models",
  "/research/multimodal-learning/": "world-models",
  "/research/sequential-decision-making/": "world-models",
  "/research/ai-agents/": "reasoning-control",
  "/research/test-time-compute/": "reasoning-control",
  "/research/agentic-workflows/": "reasoning-control",
  "/research/ai-safety/": "self-improvement",
  "/research/alignment/": "self-improvement",
  "/research/robust-learning/": "self-improvement"
};
const activeResearchSection = pathname.startsWith("/benchmarks/")
  ? "benchmarks"
  : pathname === "/research/"
    ? "overview"
    : researchSectionByPath[pathname];
const isPrimaryActive = (href: string) => {
  if (href === "/") return pathname === href;
  if (href === "/research/") return pathname.startsWith("/research/") || pathname.startsWith("/benchmarks/");
  return pathname.startsWith(href);
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#102a43" />
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:site_name" content={profile.labName} />
    <meta property="og:type" content={pageType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="Furong Huang" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,500;6..72,600&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline></script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class:list={["site-header", { "has-research-subnav": showResearchSubnav }]}>
      <a class="wordmark" href="/" aria-label="Furong Lab home">
        <span class="wordmark-mark">FH</span>
        <span>
          <strong>{profile.name}</strong>
          <small>Furong Lab · UMD</small>
        </span>
      </a>
      <nav class="desktop-nav" aria-label="Primary navigation">
        {desktopLinks.map(([href, label]) => (
          <a class:list={{ active: isPrimaryActive(href) }} href={href}>
            {label}
          </a>
        ))}
      </nav>
      <details class="mobile-nav">
        <summary>Menu <span aria-hidden="true">⌄</span></summary>
        <nav aria-label="Primary navigation">
          {mobileLinks.map(([href, label]) => (
            <a class:list={{ active: isPrimaryActive(href) }} href={href}>
              {label}
            </a>
          ))}
        </nav>
      </details>
      <a class="header-action" href="/join/">How to join <span>→</span></a>
      {showResearchSubnav && (
        <nav class="research-subnav" aria-label="Research navigation" data-research-subnav>
          {researchSubnav.map(([href, label, section]) => (
            <a
              href={href}
              data-research-target={section}
              class:list={{ active: section === activeResearchSection }}
            >
              {label}
            </a>
          ))}
        </nav>
      )}
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <div>
        <strong>{profile.labName}</strong>
        <p>Building foundation models that reason, act, recover, and improve.</p>
        <p>{profile.location} · {profile.institution}</p>
      </div>
      <div class="footer-links">
        <SocialLinks compact />
        <EmailReveal />
      </div>
      <small>© {new Date().getFullYear()} Furong Lab · University of Maryland</small>
    </footer>
    <script>
      const researchNav = document.querySelector<HTMLElement>("[data-research-subnav]");
      const initialResearchLink = researchNav?.querySelector<HTMLElement>("a.active");
      requestAnimationFrame(() => initialResearchLink?.scrollIntoView({ block: "nearest", inline: "center" }));
      if (researchNav && window.location.pathname === "/research/") {
        const links = Array.from(researchNav.querySelectorAll<HTMLAnchorElement>("[data-research-target]"));
        const sections = ["world-models", "reasoning-control", "self-improvement"]
          .map((id) => document.getElementById(id))
          .filter((section): section is HTMLElement => Boolean(section));

        const updateResearchNav = () => {
          let activeSection = "overview";
          for (const section of sections) {
            if (section.getBoundingClientRect().top <= 210) activeSection = section.id;
          }
          for (const link of links) {
            link.classList.toggle("active", link.dataset.researchTarget === activeSection);
          }
        };

        updateResearchNav();
        window.addEventListener("scroll", updateResearchNav, { passive: true });
      }
    </script>
  </body>
</html>
