  .week-lectures small { color: var(--teal); font-size: 0.65rem; font-weight: 800; }
  .week-lectures strong { font-size: 0.8rem; line-height: 1.35; }

  .project-signup-callout {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    align-items: center;
