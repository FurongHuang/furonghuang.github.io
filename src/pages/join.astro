---
import BaseLayout from "../layouts/BaseLayout.astro";
import { inquiryFormUrl } from "../data/site";

const recruitingPhdYear = 2027;

const paths = [
  {
    label: "Prospective Ph.D. students",
    status: `Open · Fall ${recruitingPhdYear}`,
    tone: "open",
    acceptsInquiry: true,
    detail:
      "Apply through the UMD Computer Science graduate admissions process. The research inquiry form is optional and does not replace the official application or admission review.",
    link: "https://www.cs.umd.edu/grad",
    linkLabel: "UMD graduate admissions"
  },
  {
    label: "Current UMD graduate students",
    status: "Open inquiries",
    tone: "open",
    acceptsInquiry: true,
    detail:
      "Use the form if you are looking for a research advisor, rotation, or sustained collaboration. Include your program, preparation, weekly availability, and one specific lab direction."
  },
  {
    label: "Current UMD undergraduates",
    status: "Open inquiries",
    tone: "open",
    acceptsInquiry: true,
    detail:
      "Use the form to request research experience. Priority goes to students who can make a sustained commitment and can point to relevant coursework, code, or a substantial technical project."
  },
  {
    label: "Research internships",
    status: "Limited availability",
    tone: "limited",
    acceptsInquiry: true,
    detail:
      "In-person and remote requests use the same form. State exact dates, location constraints, funding status, and the concrete technical contribution you are prepared to make."
  },
  {
    label: "Visiting students or scholars",
    status: "Not currently hosting",
    tone: "closed",
    acceptsInquiry: false,
    detail:
      "The lab is not currently able to host visiting students or scholars, including visits that require an invitation, sponsorship, or institutional affiliation."
  },
  {
    label: "High school students",
    status: "Program referral",
    tone: "referral",
    acceptsInquiry: false,
    detail:
      "The lab is generally unable to supervise individual high-school projects or informal internships. Eligible students should explore the Maryland Robotics Center’s structured SPARC program.",
    link: "https://robotics.umd.edu/education/student-preparation-advance-robotics-college-sparc-certificate-program",
    linkLabel: "Explore the MRC SPARC program"
  }
];

const directions = [
  {
    number: "01",
    title: "World models",
    prompt: "Learn what can happen",
    detail: "Embodied AI, multimodal learning, and sequential decision-making.",
    href: "/research/#world-models"
  },
  {
    number: "02",
    title: "Reasoning control",
    prompt: "Decide how to think",
    detail: "AI agents, test-time compute, and agentic workflows.",
    href: "/research/#reasoning-control"
  },
  {
    number: "03",
    title: "Trustworthy self-improvement",
    prompt: "Learn from failure",
    detail: "AI safety, alignment, and robust learning.",
    href: "/research/#self-improvement"
  }
];
---

<BaseLayout
  title="Join Furong Lab — Research Opportunities"
  description="Research inquiry guidance for prospective Ph.D. students, current UMD students, and internship candidates interested in Furong Lab."
>
  <section class="shell page-hero join-hero">
    <p class="eyebrow">Join Furong Lab</p>
    <h1>Start with the right path.</h1>
    <p>
      Thank you for your interest in Furong Lab. This page is the front door for research opportunities: check whether your pathway is open, identify a specific research fit, and submit one structured inquiry.
    </p>
  </section>

  <section class="shell phd-hiring-callout" aria-labelledby="phd-hiring-title">
    <div class="phd-hiring-year">
      <span>Recruiting</span>
      <strong>Fall {recruitingPhdYear}</strong>
    </div>
    <div>
      <p class="eyebrow">Ph.D. opportunities</p>
      <h2 id="phd-hiring-title">Furong Lab is hiring Ph.D. students.</h2>
      <p>
        Prospective students interested in world models, reasoning control, or trustworthy self-improvement should apply through UMD Computer Science. An optional research-fit inquiry can help the lab understand your interests, but it does not replace the official application.
      </p>
    </div>
    <a href="#right-path">Choose your path <span aria-hidden="true">↓</span></a>
  </section>

  <section class="shell section join-section" aria-labelledby="right-path">
    <div class="section-heading">
      <div><p class="eyebrow">Step 1</p><h2 id="right-path">Choose your opportunity type.</h2></div>
      <p>Availability and requirements differ by pathway. Please use the route that describes your current status rather than sending a general email.</p>
    </div>
    <div class="inquiry-grid">
      {paths.map((path) => (
        <article class:list={["inquiry-card", `status-${path.tone}`]}>
          <span class="inquiry-status">{path.status}</span>
          <h3>{path.label}</h3>
          <p>{path.detail}</p>
          <div class="inquiry-card-actions">
            {path.acceptsInquiry ? <a href="#inquiry-form">Use the inquiry form <span aria-hidden="true">↓</span></a> : null}
            {path.link ? <a href={path.link} target="_blank" rel="noreferrer">{path.linkLabel} <span aria-hidden="true">↗</span></a> : null}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="join-directions-band">
    <div class="shell section">
      <div class="section-heading">
        <div><p class="eyebrow">Step 2</p><h2>Choose one research direction.</h2></div>
        <p>Broad interests such as “AI” or “machine learning” are difficult to evaluate. Name one pillar, then identify a specific project, paper, or research question within it.</p>
      </div>
      <div class="direction-choice-grid">
        {directions.map((direction) => (
          <a class="direction-choice" href={direction.href}>
            <span>{direction.number}</span>
            <div>
              <h3>{direction.title}</h3>
              <strong>{direction.prompt}</strong>
              <p>{direction.detail}</p>
            </div>
            <i aria-hidden="true">↗</i>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="shell section join-message-section">
    <div class="section-heading">
      <div><p class="eyebrow">Step 3</p><h2>Prepare one concise submission.</h2></div>
      <p>The form is intentionally structured so inquiries can be reviewed consistently. Use links instead of large attachments and have these five items ready.</p>
    </div>
    <ol class="message-requirements">
      <li><span>01</span><div><strong>Your pathway</strong><p>Select Ph.D., current UMD graduate, current UMD undergraduate, or research internship.</p></div></li>
      <li><span>02</span><div><strong>Your research fit</strong><p>Name one Furong Lab pillar and one specific project, paper, or question that genuinely interests you.</p></div></li>
      <li><span>03</span><div><strong>Your proposed contribution</strong><p>Describe one concrete question, experiment, system, or technical direction you could pursue.</p></div></li>
      <li><span>04</span><div><strong>Evidence of preparation</strong><p>Link to your CV, code, publications, portfolio, or one substantial technical project and explain your contribution.</p></div></li>
      <li><span>05</span><div><strong>Practical constraints</strong><p>Give your dates, weekly availability, location or remote constraints, and funding status when relevant.</p></div></li>
    </ol>
  </section>

  <section class="shell section screening-section" id="inquiry-form" aria-labelledby="inquiry-form-title">
    <div class="screening-panel">
      <div>
        <p class="eyebrow">Structured intake</p>
        <h2 id="inquiry-form-title">One form. One review queue.</h2>
      </div>
      <div class="screening-copy">
        <p>
          Submit one form after reviewing the guidance above. Inquiries are reviewed for research fit, preparation, timing, and available mentoring capacity. The lab cannot guarantee an individual reply.
        </p>
        <p>
          When a candidate’s interests and timing align with current opportunities, the lab may share a private link for a short conversation. Please do not send a duplicate email after submitting the form.
        </p>
        <div class="contact-gate inquiry-form-gate">
          <strong>Ready to submit?</strong>
          <p>The form opens in a new tab and does not require a UMD or Google account. Please have your CV or résumé available as a shareable link.</p>
          <a class="inquiry-form-button" href={inquiryFormUrl} target="_blank" rel="noreferrer">
            Submit a research inquiry <span aria-hidden="true">↗</span>
          </a>
          <small>Form submissions—not direct email—are the review queue for research opportunities.</small>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
