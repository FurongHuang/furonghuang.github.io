        <li id="ref-mu0">
<a href="https://arxiv.org/abs/2606.13769" target="_blank" rel="noopener">μ₀: A Scalable 3D Interaction-Trace World Model</a>.</li>
        <li id="ref-guava">
<a href="https://arxiv.org/abs/2606.18363" target="_blank" rel="noopener">Guava: An Effective and Universal Harness for Embodied Manipulation</a>.</li>
        <li id="ref-simpler">
<a href="https://simpler-env.github.io/" target="_blank" rel="noopener">SIMPLER: Evaluating Real-World Robot Manipulation Policies in Simulation</a>.</li>
      </ol>
    </section>
