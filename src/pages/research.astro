---
import BaseLayout from "../layouts/BaseLayout.astro";
import PaperCard from "../components/PaperCard.astro";
import ResearchMap from "../components/ResearchMap.astro";
import ProjectCard from "../components/ProjectCard.astro";
import publicationData from "../data/publications.json";
import { applicationAreas, foundationalPublicationTitles, legacyProjects, projects, researchPillars } from "../data/site";
import { researchAreas } from "../data/researchAreas";

const allProjects = [...projects, ...researchAreas.flatMap((area) => area.projects)];
const representativeProjects = researchPillars.map((pillar) => {
  const project = allProjects.find((candidate) => candidate.id === pillar.featuredArea.featuredProjectId);
  if (!project) throw new Error(`Missing representative project ${pillar.featuredArea.featuredProjectId}`);
  return project;
});
const works = publicationData.works as any[];
const foundationalTitles = [
  "Escaping From Saddle Points - Online Stochastic Gradient for Tensor Decomposition",
  ...foundationalPublicationTitles.filter((title) => title !== "Escaping From Saddle Points - Online Stochastic Gradient for Tensor Decomposition")
];
const foundationalVenueOverrides: Record<string, string> = {
  "Efficient Adversarial Training without Attacking: Worst-Case-Aware Robust Reinforcement Learning": "Advances in Neural Information Processing Systems (NeurIPS), 2022",
  "Rethinking Adversarial Policies: A Generalized Attack Formulation and Provable Defense in RL": "The Twelfth International Conference on Learning Representations (ICLR), 2024"
};
const foundationalWorks = foundationalTitles
  .map((title) => works.find((work) => work.title === title))
  .filter(Boolean)
  .map((work) => ({ ...work, venue: foundationalVenueOverrides[work.title] || work.venue }));
const researchEvolution = [
  {
    years: "2011–2015",
    title: "Structure and latent variables",
    detail: "Graphical models, tensor methods, and identifiable structure in high-dimensional learning."
  },
  {
    years: "2015–2019",
    title: "Tensor methods and nonconvex optimization",
    detail: "Scalable tensor algorithms, latent-variable learning, saddle-point escape, and efficient theory for modern optimization landscapes."
  },
  {
    years: "2019–present",
    title: "Reinforcement learning, robustness, and fairness",
    detail: "Sequential decision-making, robust and multi-agent reinforcement learning, adversarial training, and fairness under shift."
  },
  {
    years: "2023–present",
    title: "Multimodal and embodied intelligence",
    detail: "Vision-language reasoning, diagnostic evaluation, robotics, and models grounded in physical interaction."
  },
  {
    years: "2025–present",
    title: "Reasoning control and trustworthy self-improvement",
    detail: "Agents, test-time computation, world models, and feedback loops that learn from failure."
  }
];
---

<BaseLayout title="Research — Furong Lab">
  <section class="shell page-hero research-hero">
    <p class="eyebrow">Research program</p>
    <h1>Foundation models as decision-making systems.</h1>
    <p>
      Furong Lab studies models that allocate computation, choose tools and collaborators, act in physical environments, and revise behavior after failure. Select any pillar or topic to follow the work from research question to project and paper.
    </p>
  </section>

  <section class="shell section" style="padding-top: 1rem">
    <ResearchMap />
  </section>

  <section class="shell section research-evolution-section" aria-labelledby="research-evolution-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Research evolution</p>
        <h2 id="research-evolution-title">One program, evolving across methods and systems.</h2>
      </div>
      <p>
        The current pillars extend a consistent question: how can learning systems recover structure, make reliable decisions under uncertainty, and improve from difficult feedback?
      </p>
    </div>
    <ol class="research-evolution" aria-label="Evolution of Furong Huang's research program">
      {researchEvolution.map((stage, index) => (
        <li>
          <div class="research-evolution-marker" aria-hidden="true"><span>{String(index + 1).padStart(2, "0")}</span></div>
          <p>{stage.years}</p>
          <h3>{stage.title}</h3>
          <span>{stage.detail}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="shell research-infrastructure-entry">
    <a class="infrastructure-card" href="/benchmarks/">
      <div>
        <p class="eyebrow">Research infrastructure</p>
        <h2>Data, benchmarks <em>& evaluation.</em></h2>
        <p>Explore the datasets, stress tests, competitions, and evaluation platforms that turn research questions into measurable evidence.</p>
      </div>
      <div class="infrastructure-card-action">
        <strong>Explore the collection</strong>
        <span aria-hidden="true">→</span>
      </div>
    </a>
  </section>

  {researchPillars.map((pillar) => (
    <section class={`pillar-section pillar-section-${pillar.id}`} id={pillar.id}>
      <div class="shell pillar-section-inner">
        <div class="pillar-intro">
          <p class="eyebrow">Pillar {pillar.number}</p>
          <h2>{pillar.title}</h2>
          <strong>{pillar.subtitle}</strong>
          <p>{pillar.description}</p>
          <div class="topic-links">
            {pillar.topics.map((topic) => <a href={topic.href}>{topic.label}<span>→</span></a>)}
          </div>
        </div>
        <div class="pillar-feature">
          <div class:list={["pillar-feature-visual", `media-${pillar.featuredArea.imageFit || "contain"}`]} style={`--media-position: ${pillar.featuredArea.imagePosition || "50% 50%"}`}>
            <img src={pillar.featuredArea.image} alt={pillar.featuredArea.imageAlt} loading="lazy" decoding="async" width="1600" height="900" />
            <span>Pillar {pillar.number} flagship</span>
          </div>
          <div class="pillar-feature-body">
            <p class="eyebrow">Featured area</p>
            <h3>{pillar.featuredArea.title}</h3>
            <p>{pillar.featuredArea.description}</p>
            <div class="button-row pillar-actions">
              <a class="button" href={pillar.featuredArea.href}>Explore {pillar.featuredArea.title} <span>→</span></a>
              <a class="button secondary" href={`/publications/?pillar=${pillar.id}`}>View all {pillar.shortTitle} papers <span>→</span></a>
            </div>
          </div>
        </div>
      </div>
    </section>
  ))}

  <section class="shell section">
    <div class="section-heading">
      <div><p class="eyebrow">Research in the world</p><h2>Methods become meaningful through where they are used.</h2></div>
      <p>The lab’s theoretical and systems work has reached problems in science, infrastructure, finance, content integrity, and embodied intelligence.</p>
    </div>
    <div class="content-grid application-grid">
      {applicationAreas.map((application) => (
        <article class="content-card">
          <h3>{application.title}</h3>
          <p>{application.detail}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="shell section">
    <div class="section-heading">
      <div><p class="eyebrow">Representative projects</p><h2>Systems, evidence, and open research artifacts.</h2></div>
      <p>Project pages bring together papers, code, demonstrations, and the visual evidence behind the research.</p>
    </div>
    <div class="project-grid featured-project-grid">
      {representativeProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="research-foundations">
    <div class="shell section">
      <div class="section-heading">
        <div><p class="eyebrow">Research foundations</p><h2>Earlier work that shaped the current program.</h2></div>
        <p>Optimization, latent-structure learning, graphical models, learning theory, fairness, and robustness established ideas that continue through the lab’s current work on foundation models.</p>
      </div>
      <div class="project-grid legacy-project-grid">
        {legacyProjects.map((project) => <ProjectCard project={project} />)}
      </div>
      <div class="section-heading foundation-paper-heading" style="margin-top: 5rem">
        <div><p class="eyebrow">Foundational papers</p><h2>Methods beneath the modern systems.</h2></div>
        <p>Selected contributions trace a path from nonconvex optimization and latent-structure recovery to adversarial training, robust sequential decisions, and provable defenses.</p>
      </div>
      <div class="paper-grid foundational-paper-grid">
        {foundationalWorks.map((paper) => <PaperCard paper={paper} eagerImage thumbnailFit="contain" />)}
      </div>
    </div>
  </section>
</BaseLayout>
