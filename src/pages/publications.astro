---
import BaseLayout from "../layouts/BaseLayout.astro";
import PaperCard from "../components/PaperCard.astro";
import PublicationHistory from "../components/PublicationHistory.astro";
import publicationData from "../data/publications.json";
import { pillarMeta } from "../data/research";

const arxivRecency = (work: any) => {
  const identifier = String(work.identifiers?.arxiv || "").match(/^(\d{2})(\d{2})\.(\d+)/);
  if (!identifier) return 0;
  return Number(`${identifier[1]}${identifier[2]}${identifier[3].padStart(5, "0")}`);
};

const works = [...(publicationData.works as any[])].sort((a, b) =>
  (b.year || 0) - (a.year || 0) ||
  arxivRecency(b) - arxivRecency(a) ||
  a.title.localeCompare(b.title)
);
const years = Array.from(new Set(works.map((work) => work.year).filter(Boolean))).sort((a, b) => b - a);
const categories = Array.from(new Set(works.map((work) => work.category).filter(Boolean))).sort();
const appearances = works.flatMap((work) => work.appearances || []);
const appearanceCounts = appearances.reduce((result: Record<string, number>, appearance) => {
  result[appearance.category] = (result[appearance.category] || 0) + 1;
  return result;
}, {});
---

<BaseLayout title="Publications — Furong Huang" description="Search and explore Furong Huang's publications in trustworthy AI, foundation models, agents, robotics, and machine learning.">
  <section class="shell page-hero">
    <p class="eyebrow">Complete scholarly record</p>
    <h1>Publications</h1>
  </section>

  <section class="shell publication-overview" aria-label="Publication overview">
    <div class="metrics-strip compact-metrics publication-metrics">
      <div class="metric"><strong>{appearances.length}</strong><span>CV publication entries</span></div>
      <div class="metric"><strong>{appearanceCounts.conference || 0}</strong><span>Conference entries</span></div>
      <div class="metric"><strong>{appearanceCounts.workshop || 0}</strong><span>Workshop entries</span></div>
      <div class="metric"><strong>{appearanceCounts.journal || 0}</strong><span>Journal entries</span></div>
      <div class="metric"><strong>{appearanceCounts.preprint || 0}</strong><span>Preprints</span></div>
    </div>
    <div class="publication-trajectory">
      <div class="publication-trajectory-copy">
        <p class="eyebrow">Research trajectory</p>
        <h2>A long-running program across theory and systems.</h2>
      </div>
      <PublicationHistory works={appearances} asOf={publicationData.as_of} />
    </div>
  </section>

  <section class="shell section" style="padding-top: 0">
    <div class="publication-controls" aria-label="Publication filters">
      <input id="publication-search" type="search" placeholder="Search title, author, venue…" aria-label="Search publications" />
      <select id="publication-category" aria-label="Filter by publication category">
        <option value="">All publication types</option>
        {categories.map((category) => <option value={category}>{category[0].toUpperCase() + category.slice(1)}</option>)}
      </select>
      <select id="publication-pillar" aria-label="Filter by research pillar">
        <option value="">All research pillars</option>
        {Object.entries(pillarMeta).map(([id, pillar]) => <option value={id}>{pillar.shortLabel}</option>)}
      </select>
      <select id="publication-year" aria-label="Filter by year">
        <option value="">All years</option>
        {years.map((year) => <option value={year}>{year}</option>)}
      </select>
      <span class="publication-count" id="publication-count">{works.length} records</span>
    </div>

    <div class="publication-list" id="publication-list">
      {works.map((paper, index) => <PaperCard paper={paper} compact initiallyHidden={index >= 30} />)}
    </div>
    <div class="button-row publication-more-row">
      <button class="button secondary publication-more" id="publication-more" type="button">Show more publications</button>
    </div>
    <div class="empty-state" id="publication-empty">
      <h2>No matching publications</h2>
      <p>Try a broader keyword or clear one of the filters.</p>
    </div>
  </section>

  <script>
    const search = document.querySelector<HTMLInputElement>("#publication-search");
    const category = document.querySelector<HTMLSelectElement>("#publication-category");
    const year = document.querySelector<HTMLSelectElement>("#publication-year");
    const pillar = document.querySelector<HTMLSelectElement>("#publication-pillar");
    const count = document.querySelector<HTMLElement>("#publication-count");
    const empty = document.querySelector<HTMLElement>("#publication-empty");
    const more = document.querySelector<HTMLButtonElement>("#publication-more");
    const papers = Array.from(document.querySelectorAll<HTMLElement>("[data-paper]"));
    const pageSize = 30;
    let displayLimit = pageSize;

    const updatePublicationUrl = () => {
      const params = new URLSearchParams(window.location.search);
      const values = {
        q: search?.value.trim() || "",
        category: category?.value || "",
        pillar: pillar?.value || "",
        year: year?.value || ""
      };

      for (const [key, value] of Object.entries(values)) {
        if (value) params.set(key, value);
        else params.delete(key);
      }

      const query = params.toString();
      history.replaceState(null, "", `${window.location.pathname}${query ? `?${query}` : ""}${window.location.hash}`);
    };

    const filterPublications = (syncUrl = false) => {
      const query = search?.value.trim().toLowerCase() || "";
      const selectedCategory = category?.value || "";
      const selectedYear = year?.value || "";
      const selectedPillar = pillar?.value || "";
      const filtering = Boolean(query || selectedCategory || selectedYear || selectedPillar);
      let matches = 0;

      for (const paper of papers) {
        const matchesQuery = !query || (paper.dataset.search || "").includes(query);
        const matchesCategory = !selectedCategory || paper.dataset.category === selectedCategory;
        const matchesYear = !selectedYear || paper.dataset.year === selectedYear;
        const matchesPillar = !selectedPillar || paper.dataset.pillar === selectedPillar;
        const isMatch = matchesQuery && matchesCategory && matchesYear && matchesPillar;
        if (isMatch) matches += 1;
        paper.hidden = !isMatch || (!filtering && matches > displayLimit);
      }

      const shown = filtering ? matches : Math.min(matches, displayLimit);
      if (count) count.textContent = filtering
        ? `${matches} ${matches === 1 ? "record" : "records"}`
        : `${shown} of ${matches} records`;
      if (empty) empty.style.display = matches === 0 ? "block" : "none";
      if (more) more.hidden = filtering || shown >= matches;
      if (syncUrl) updatePublicationUrl();
    };

    search?.addEventListener("input", () => filterPublications(true));
    category?.addEventListener("change", () => filterPublications(true));
    year?.addEventListener("change", () => filterPublications(true));
    pillar?.addEventListener("change", () => filterPublications(true));
    more?.addEventListener("click", () => {
      displayLimit += pageSize;
      filterPublications(false);
    });

    const params = new URLSearchParams(window.location.search);
    if (search && params.has("q")) search.value = params.get("q") || "";
    if (category && params.has("category")) category.value = params.get("category") || "";
    if (year && params.has("year")) year.value = params.get("year") || "";
    if (pillar && params.has("pillar")) pillar.value = params.get("pillar") || "";
    filterPublications(false);
  </script>
</BaseLayout>
