---
import BaseLayout from "../layouts/BaseLayout.astro";
import { existsSync, readdirSync } from "node:fs";
import { resolve } from "node:path";

const slideRoot = "/courses/cmsc848n/fall-2026/slides";
const slideDirectory = resolve(process.cwd(), "public/courses/cmsc848n/fall-2026/slides");
const releasedSlides = new Set<string>(
  existsSync(slideDirectory)
    ? readdirSync(slideDirectory).filter((filename) => filename.toLowerCase().endsWith(".pptx"))
    : []
);

const courseDateFormatter = new Intl.DateTimeFormat("en-US", {
  timeZone: "UTC",
  weekday: "short",
  month: "short",
  day: "numeric"
});

const formatCourseDate = (date: string) => courseDateFormatter.format(new Date(`${date}T12:00:00Z`));
const formatReleaseDate = (date: string) => {
  const releaseDate = new Date(`${date}T12:00:00Z`);
  releaseDate.setUTCDate(releaseDate.getUTCDate() - 2);
  return courseDateFormatter.format(releaseDate);
};

const modules = [
  {
    number: "01",
    module: "Agent-system foundations",
    outcome: "Define the complete agent system and reason about sequential experience.",
    lectures: [
      ["2026-09-01", "Agent Systems: The Model Is Not the Agent", "W1-L1-Agent-Systems-The-Model-Is-Not-the-Agent.pptx"],
      ["2026-09-03", "RL Essentials for Agents", "W1-L2-RL-Essentials-for-Agents.pptx"]
    ]
  },
  {
    number: "02",
    module: "Learning agent policies",
    outcome: "Learn from demonstrations, preferences, and verifiable feedback.",
    lectures: [
      ["2026-09-08", "Learning Agent Policies from Feedback", "W2-L1-Learning-Agent-Policies-from-Feedback.pptx"],
      ["2026-09-10", "Training Multi-Turn Agents: Rollouts, Credit, and Stability", "W2-L2-Training-Multi-Turn-Agents.pptx"]
    ]
  },
  {
    number: "03",
    module: "Reasoning and adaptive inference",
    outcome: "Control search, verification, compute, recovery, and stopping at test time.",
    lectures: [
      ["2026-09-15", "Reasoning at Test Time: Traces, Search, Verifiers, and Compute", "W3-L1-Reasoning-at-Test-Time.pptx"],
      ["2026-09-17", "Adaptive Inference Control: Critics, Stopping, Recovery, and Efficiency", "W3-L2-Adaptive-Inference-Control.pptx"]
    ]
  },
  {
    number: "04",
    module: "Planning, state, memory, and context",
    outcome: "Build explicit state and memory that support controlled replanning.",
    lectures: [
      ["2026-09-22", "Planning and State", "W4-L1-Planning-and-State.pptx"],
      ["2026-09-24", "Memory and Context Engineering", "W4-L2-Memory-and-Context-Engineering.pptx"]
    ]
  },
  {
    number: "05",
    module: "Tools, protocols, and authority",
    outcome: "Design typed tools with bounded authority, verification, and audit.",
    lectures: [
      ["2026-09-29", "Tool Interfaces and Action Protocols", "W5-L1-Tool-Interfaces-and-Action-Protocols.pptx"],
      ["2026-10-01", "Authorization and Safe Execution", "W5-L2-Authorization-and-Safe-Execution.pptx"]
    ]
  },
  {
    number: "06",
    module: "Durable composition",
    outcome: "Compose agents into workflows and justified multi-agent teams.",
    lectures: [
      ["2026-10-06", "Agentic Workflows and Orchestration", "W6-L1-Agentic-Workflows-and-Orchestration.pptx"],
      ["2026-10-08", "Multi-Agent Systems", "W6-L2-Multi-Agent-Systems.pptx"]
    ]
  },
  {
    number: "07",
    module: "Web agents",
    outcome: "Build browser agents that ground actions and resist adversarial content.",
    lectures: [
      ["2026-10-15", "Web Agents: Perception, Control, and Evaluation", "W7-L1-Web-Agents-Perception-Control-and-Evaluation.pptx"],
      ["2026-10-20", "Securing Web Agents: Intent, Privilege, and Adversarial Content", "W7-L2-Securing-Web-Agents-Intent-Privilege-and-Adversarial-Content.pptx"]
    ]
  },
  {
    number: "08",
    module: "Coding agents",
    outcome: "Navigate repositories, execute repair loops, and evaluate patches validly.",
    lectures: [
      ["2026-10-22", "Coding Agents: Repository Navigation and Repair Loops", "W8-L1-Coding-Agents-Repository-Navigation-and-Repair-Loops.pptx"],
      ["2026-10-27", "Coding Agents II: Execution, Training, and Valid Evaluation", "W8-L2-Coding-Agents-Execution-Training-and-Valid-Evaluation.pptx"]
    ]
  },
  {
    number: "09",
    module: "Research and scientific agents",
    outcome: "Connect sources, claims, hypotheses, experiments, and qualified conclusions.",
    lectures: [
      ["2026-10-29", "Deep Research Agents: Search, Evidence, and Reproducible Synthesis", "W9-L1-Deep-Research-Agents-Search-Evidence-and-Reproducible-Synthesis.pptx"],
      ["2026-11-03", "Scientific Discovery Agents: Hypotheses, Experiments, and Valid Claims", "W9-L2-Scientific-Discovery-Agents-Hypotheses-Experiments-and-Valid-Claims.pptx"]
    ]
  },
  {
    number: "10",
    module: "Embodied agents and robotics",
    outcome: "Design and evaluate closed-loop world-model and vision-language-action agents.",
    lectures: [
      ["2026-11-05", "World Models and Vision-Language-Action Agents", "W10-L1-World-Models-and-Vision-Language-Action-Agents.pptx"],
      ["2026-11-10", "Data-Efficient Embodied Learning and Evaluation", "W10-L2-Data-Efficient-Embodied-Learning-and-Evaluation.pptx"]
    ]
  },
  {
    number: "11",
    module: "Agent robustness and safety",
    outcome: "Threat-model the lifecycle and plan prevention, monitoring, and recovery.",
    lectures: [
      ["2026-11-12", "Adversarial Threats Across the Agent Lifecycle", "W11-L1-Adversarial-Threats-Across-the-Agent-Lifecycle.pptx"],
      ["2026-11-17", "Defense in Depth, Monitoring, and Incident Response", "W11-L2-Defense-in-Depth-Monitoring-and-Incident-Response.pptx"]
    ]
  },
  {
    number: "12",
    module: "Learning from experience and self-improvement",
    outcome: "Govern persistent adaptation with evaluation, lineage, retention, and rollback.",
    lectures: [
      ["2026-11-19", "Learning from Experience: Prompts, Skills, Policies, and Continual Adaptation", "W12-L1-Learning-from-Experience-Prompts-Skills-Policies-and-Continual-Adaptation.pptx"],
      ["2026-11-24", "Self-Modifying and Evolutionary Agents", "W12-L2-Self-Modifying-and-Evolutionary-Agents.pptx"]
    ]
  },
  {
    number: "13",
    module: "Evaluation, provenance, and synthesis",
    outcome: "Make deployment decisions from reproducible evidence and accountable provenance.",
    lectures: [
      ["2026-12-01", "Agent Evaluation and Deployment Evidence", "W13-L1-Agent-Evaluation-and-Deployment-Evidence.pptx"],
      ["2026-12-03", "Provenance, Watermarking, and Frontier Challenges", "W13-L2-Provenance-Watermarking-and-Frontier-Challenges.pptx"]
    ]
  }
];

const assessments = [
  ["10%", "Trace diagnosis", "Short in-class analysis of agent behavior and failure."],
  ["20%", "Implementation labs", "Minimal agents, tool boundaries, evaluation, and red-teaming."],
  ["30%", "Midterm package", "Literature map, runnable baseline, results, and evaluation plan."],
  ["20%", "Final presentation", "A concise claim–evidence narrative with limitations."],
  ["20%", "Final artifacts", "Paper-style report, code, traces, ablations, and safety analysis."]
];

const milestones = [
  ["Weeks 1–2", "Choose and form teams", "Select a project from the course catalog, personalize its direction, and establish a shared workspace."],
  ["Week 4", "Proposal", "Submit the task contract, benchmark or environment, and one-page plan."],
  ["Week 6", "Baseline", "Deliver a runnable baseline and the first reproducible evidence bundle."],
  ["Week 8", "Midterm package", "Report preliminary results and a concrete failure taxonomy."],
  ["Week 10", "Freeze evaluation", "Lock held-out tasks, metrics, budgets, and contamination controls."],
  ["Week 12", "Artifact audit", "Peer review, regression check, security test, and release rehearsal."],
  ["Dec 8 & 10", "Present and release", "Final presentations, paper-style report, and runnable artifacts."]
];

const projectBriefFields = [
  ["01", "Motivation & gap", "Why the problem matters and what unresolved gap makes it worth pursuing."],
  ["02", "Question & novelty", "A concrete research question and the seed of a new, defensible contribution."],
  ["03", "Closest prior work", "Starting references, relevant systems, and the work a new result must improve upon."],
  ["04", "Research hypothesis", "A technically credible first route, with space for the team to develop its own approach."],
  ["05", "Data & baselines", "Datasets, environments, comparison points, and practical starting assets."],
  ["06", "Conference-level evidence", "Metrics, budgets, strong baselines, ablations, and failure analyses for a valid claim."],
  ["07", "Research artifacts", "A conference-style paper, reproducible code, evidence, and a concise presentation."]
];

const references = [
  ["Reinforcement Learning: An Introduction", "Sutton & Barto · 2018", "https://web.stanford.edu/class/psych209/Readings/SuttonBartoIPRLBook2ndEd.pdf"],
  ["A Survey on Large Language Model Based Autonomous Agents", "Wang et al. · 2024", "https://arxiv.org/abs/2308.11432"],
  ["Direct Preference Optimization", "Rafailov et al. · 2023", "https://arxiv.org/abs/2305.18290"],
  ["ReAct: Synergizing Reasoning and Acting", "Yao et al. · 2023", "https://arxiv.org/abs/2210.03629"],
  ["Toolformer", "Schick et al. · 2023", "https://arxiv.org/abs/2302.04761"],
  ["WebArena", "Zhou et al. · 2024", "https://arxiv.org/abs/2307.13854"],
  ["SWE-bench", "Jimenez et al. · 2024", "https://arxiv.org/abs/2310.06770"]
];

---

<BaseLayout
  title="CMSC 848N — Generative AI Agents · Fall 2026"
  description="Fall 2026 at the University of Maryland: foundations and frontiers of generative AI agents."
  image="/courses/cmsc848n/fall-2026/og.png"
  imageAlt="CMSC 848N Generative AI Agents · Fall 2026 · University of Maryland"
>
  <section class="shell course-hero">
    <div class="course-hero-copy">
      <p class="eyebrow">Fall 2026 · CMSC 848N · University of Maryland</p>
      <h1>Generative<br /><em>AI Agents</em></h1>
      <p class="course-lede">
        Foundations and frontiers of systems that reason, plan, act, use tools, and adapt in complex environments.
      </p>
      <div class="button-row">
        <a class="button" href="#schedule">View schedule <span aria-hidden="true">↓</span></a>
        <a class="button secondary" href="#projects">Join a project <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <aside class="course-at-a-glance" aria-label="Course at a glance">
      <p class="eyebrow">At a glance</p>
      <div><strong>15</strong><span>semester weeks</span></div>
      <div><strong>26</strong><span>lectures</span></div>
      <div><strong>15</strong><span>personalized research projects</span></div>
      <p>Tuesdays & Thursdays · 11:00 a.m.–12:15 p.m. · CSI 3117</p>
    </aside>
  </section>

  <nav class="shell course-quick-links" aria-label="Course shortcuts">
    <a href="#overview"><span>01</span> Overview</a>
    <a href="#schedule"><span>02</span> Schedule & slides</a>
    <a href="#projects"><span>03</span> Project signup</a>
    <a href="#policies"><span>04</span> Policies</a>
  </nav>

  <section id="overview" class="shell section course-overview">
    <div class="course-section-heading">
      <div>
        <p class="eyebrow">The course</p>
        <h2>Build agents whose claims can survive contact with the world.</h2>
      </div>
      <div>
        <p>
          An agent is more than a model. It is a governed sequential decision system: model, controller, environment, state and memory, tools and protocols, authority policy, evaluator, and people.
        </p>
        <p>
          We will connect theoretical foundations to modern practice, with an emphasis on algorithmic building blocks, valid evaluation, and open research problems.
        </p>
      </div>
    </div>

    <div class="course-facts">
      <article><span>Instructor</span><strong>Prof. Furong Huang</strong><p>Computer Science · UMD</p></article>
      <article><span>Meetings</span><strong>Tue & Thu · 11:00–12:15</strong><p>CSI 3117 · America/New_York</p></article>
      <article><span>Prerequisites</span><strong>ML + deep learning</strong><p>Probability, optimization, linear algebra, and Python</p></article>
      <article><span>Coursework</span><strong>Evidence over demos</strong><p>Diagnosis, implementation, and one personalized research project</p></article>
    </div>
  </section>

  <section id="schedule" class="course-band">
    <div class="shell section">
      <div class="course-section-heading compact">
        <div><p class="eyebrow">Schedule & slides</p><h2>Thirteen modules, one cumulative argument.</h2></div>
        <p>Fall classes run August 31–December 11. CMSC 848N meets September 1–December 10; each approved deck appears exactly two days before its 11:00 a.m. lecture. Dates follow the <a href="https://academiccatalog.umd.edu/about-university/academic-calendar/semester-calendar/semester-calendar.pdf">official UMD semester calendar</a>.</p>
      </div>

      <ol class="course-schedule">
        {modules.map(({ number, module, outcome, lectures }) => (
          <li>
            <div class="week-number"><span>Module</span><strong>{number}</strong></div>
            <div class="week-topic"><h3>{module}</h3><p>{outcome}</p></div>
            <div class="week-lectures">
              {lectures.map(([date, title, file], index) => releasedSlides.has(file) ? (
                <a class="lecture-item" href={`${slideRoot}/${file}`} download>
                  <div class="lecture-meta"><span>L{index + 1}</span><time datetime={date}>{formatCourseDate(date)}</time></div>
                  <strong>{title}</strong>
                  <small>PPTX ↓</small>
                </a>
              ) : (
                <div class="lecture-item is-pending">
                  <div class="lecture-meta"><span>L{index + 1}</span><time datetime={date}>{formatCourseDate(date)}</time></div>
                  <strong>{title}</strong>
                  <small>Slides {formatReleaseDate(date)} · 11 AM</small>
                </div>
              ))}
            </div>
          </li>
        ))}
      </ol>

      <div class="calendar-markers" aria-label="Fall 2026 schedule exceptions and final meetings">
        <article><span>No class</span><strong>Tue · Oct 13</strong><p>UMD Fall Break</p></article>
        <article><span>No class</span><strong>Thu · Nov 26</strong><p>UMD Thanksgiving Recess</p></article>
        <article><span>Final meetings</span><strong>Dec 8 & 10 · 11:00 AM</strong><p>Personalized research project presentations</p></article>
      </div>
    </div>
  </section>

  <section id="projects" class="shell section projects-section">
    <div class="course-section-heading">
      <div><p class="eyebrow">Personalized research project</p><h2>Choose one project. Make it your own.</h2></div>
      <div>
        <p>Professor Huang is designing a new catalogue of ambitious research candidates for the class. Each begins with a real open problem and a credible path toward a publishable contribution. Detailed briefs are available to enrolled students with the course password.</p>
      </div>
    </div>

    <div
      class="project-signup-callout"
      data-catalog-lock
      data-catalog-url="/courses/cmsc848n/fall-2026/project-catalog.v1.json"
    >
      <div>
        <p class="eyebrow">Protected project catalogue</p>
        <h3>Unlock the Fall 2026 research briefs.</h3>
        <p>The detailed catalogue is encrypted. Enter the password shared by Professor Huang to review the candidate questions, technical hypotheses, evidence requirements, and starting papers.</p>
      </div>
      <form class="project-unlock-form" data-catalog-form>
        <label for="project-catalog-password">Course password</label>
        <div>
          <input
            id="project-catalog-password"
            name="password"
            type="password"
            autocomplete="current-password"
            spellcheck="false"
            required
            data-catalog-password
          />
          <button class="button course-button-light" type="submit" data-catalog-submit>Unlock</button>
        </div>
        <p role="status" aria-live="polite" data-catalog-status>Password is checked in this browser and is never submitted.</p>
      </form>
    </div>

    <noscript><p class="catalog-noscript">JavaScript is required to decrypt the protected project catalogue.</p></noscript>

    <div class="protected-catalog" hidden data-catalog-shell>
      <div class="catalog-heading">
        <div><p class="eyebrow">Fall 2026 candidate catalogue</p><h3>Open a brief. Find the question you want to sharpen.</h3></div>
        <div><p>Rank several candidates and propose one personalization. Final scopes will reflect team preparation, available compute, and overlap across the class.</p><button type="button" data-catalog-relock>Lock catalogue</button></div>
      </div>
      <div class="project-catalog" data-project-catalog aria-label="Fall 2026 research project candidates"></div>
    </div>

    <p class="eyebrow">Every candidate will be a complete research brief</p>
    <div class="project-directions" aria-label="Information included in each project candidate">
      {projectBriefFields.map(([number, title, detail]) => (
        <article><span>{number}</span><h3>{title}</h3><p>{detail}</p></article>
      ))}
    </div>

    <div class="milestone-section">
      <p class="eyebrow">Milestones</p>
      <ol class="milestone-list">
        {milestones.map(([when, title, detail]) => (
          <li><span>{when}</span><strong>{title}</strong><p>{detail}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="course-band assessment-band">
    <div class="shell section">
      <div class="course-section-heading compact">
        <div><p class="eyebrow">Assessment</p><h2>Measure the work by its evidence.</h2></div>
        <p>The final syllabus will confirm all due dates and policies. The planned weighting below anchors the course design.</p>
      </div>
      <div class="assessment-grid">
        {assessments.map(([weight, title, detail]) => (
          <article><strong>{weight}</strong><h3>{title}</h3><p>{detail}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section id="resources" class="shell section resources-section">
    <div class="course-section-heading compact">
      <div><p class="eyebrow">Starting references</p><h2>Read the primary work.</h2></div>
      <p>Additional readings will be posted by week. We will distinguish peer-reviewed work, preprints, official specifications, vendor evidence, and course synthesis.</p>
    </div>
    <div class="reference-list">
      {references.map(([title, meta, url], index) => (
        <a href={url}>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <strong>{title}</strong>
          <small>{meta}</small>
          <i aria-hidden="true">↗</i>
        </a>
      ))}
    </div>
  </section>

  <section id="policies" class="shell section policies-section">
    <div class="course-section-heading compact">
      <div><p class="eyebrow">Working policies</p><h2>Clear expectations, before launch.</h2></div>
      <p>These are planning guidelines. The official Fall 2026 syllabus and University policies will supersede this page where they differ.</p>
    </div>
    <div class="policy-grid">
      <article><h3>Collaboration</h3><p>Collaboration is expected within project teams. Individual assessments must reflect your own understanding. Credit every external contribution, library, model, dataset, prompt source, and borrowed artifact.</p></article>
      <article><h3>Generative AI use</h3><p>AI tools are part of the subject matter and may be used when the assignment permits. Preserve prompts, model and version information, tool traces, and material edits so results remain auditable.</p></article>
      <article><h3>Responsible experimentation</h3><p>Use least privilege, sandbox side effects, protect private data, and obtain approval before tests that touch people or external systems. Projects with consequential actions require monitoring and rollback ownership.</p></article>
      <article><h3>Accessibility & support</h3><p>Students who need accommodations should contact the University’s accessibility service and the instructor early. Please raise barriers to course materials or participation as soon as possible.</p></article>
    </div>
  </section>

  <section class="shell course-final-cta">
    <p class="eyebrow">CMSC 848N · Fall 2026</p>
    <h2>Models speak. Agents change state.</h2>
    <p>Our job is to understand the system in between—and demand evidence for what it can safely do.</p>
    <div class="button-row">
      <a class="button" href="#schedule">View slide schedule ↓</a>
      <a class="button secondary" href="#projects">View project plan ↑</a>
    </div>
  </section>
</BaseLayout>

<script>
  type ProjectCandidate = {
    number: string;
    track: string;
    title: string;
    challenge: string;
    question: string;
    hypothesis: string;
    evidence: string;
    personalize: string;
    skills: string[];
    startingPoints: [string, string][];
  };

  type EncryptedCatalog = {
    version: number;
    kdf: "PBKDF2";
    hash: "SHA-256";
    iterations: number;
    cipher: "AES-GCM";
    salt: string;
    iv: string;
    aad: string;
    ciphertext: string;
  };

  const lock = document.querySelector<HTMLElement>("[data-catalog-lock]");
  const form = document.querySelector<HTMLFormElement>("[data-catalog-form]");
  const passwordInput = document.querySelector<HTMLInputElement>("[data-catalog-password]");
  const submitButton = document.querySelector<HTMLButtonElement>("[data-catalog-submit]");
  const status = document.querySelector<HTMLElement>("[data-catalog-status]");
  const catalogShell = document.querySelector<HTMLElement>("[data-catalog-shell]");
  const catalog = document.querySelector<HTMLElement>("[data-project-catalog]");
  const relockButton = document.querySelector<HTMLButtonElement>("[data-catalog-relock]");

  if (lock && form && passwordInput && submitButton && status && catalogShell && catalog && relockButton) {
    const encoder = new TextEncoder();
    const decoder = new TextDecoder();
    let encryptedCatalog: Promise<EncryptedCatalog> | null = null;

    const fromBase64 = (value: string) => {
      const decoded = atob(value);
      return Uint8Array.from(decoded, (character) => character.charCodeAt(0));
    };

    const loadEncryptedCatalog = () => {
      if (!encryptedCatalog) {
        const url = lock.dataset.catalogUrl;
        if (!url) throw new Error("Missing catalogue URL");
        encryptedCatalog = fetch(url, { cache: "no-store" }).then(async (response) => {
          if (!response.ok) throw new Error("Catalogue unavailable");
          return response.json() as Promise<EncryptedCatalog>;
        });
      }
      return encryptedCatalog;
    };

    const textElement = <K extends keyof HTMLElementTagNameMap>(tag: K, text: string, className?: string) => {
      const element = document.createElement(tag);
      element.textContent = text;
      if (className) element.className = className;
      return element;
    };

    const addBriefField = (list: HTMLDListElement, label: string, value: string) => {
      const row = document.createElement("div");
      row.append(textElement("dt", label), textElement("dd", value));
      list.append(row);
    };

    const renderCatalog = (projects: ProjectCandidate[]) => {
      const fragment = document.createDocumentFragment();

      projects.forEach((project) => {
        const card = document.createElement("details");
        card.className = "project-card";

        const summary = document.createElement("summary");
        const meta = document.createElement("div");
        meta.className = "project-card-meta";
        meta.append(textElement("span", project.number), textElement("small", project.track));
        summary.append(
          meta,
          textElement("h4", project.title),
          textElement("p", project.challenge),
          textElement("span", "Open research brief", "project-open-label")
        );

        const body = document.createElement("div");
        body.className = "project-card-body";
        const fields = document.createElement("dl");
        addBriefField(fields, "Research question", project.question);
        addBriefField(fields, "Technical hypothesis", project.hypothesis);
        addBriefField(fields, "Evidence bar", project.evidence);
        addBriefField(fields, "Make it yours", project.personalize);

        const skills = document.createElement("div");
        skills.className = "project-skills";
        skills.setAttribute("aria-label", "Useful preparation");
        project.skills.forEach((skill) => skills.append(textElement("span", skill)));

        const reading = document.createElement("div");
        reading.className = "project-reading";
        reading.append(textElement("strong", "Starting points"));
        project.startingPoints.forEach(([label, url]) => {
          const parsedUrl = new URL(url);
          if (parsedUrl.protocol !== "https:" && parsedUrl.protocol !== "http:") return;
          const link = textElement("a", `${label} ↗`);
          link.href = parsedUrl.href;
          link.target = "_blank";
          link.rel = "noopener noreferrer";
          reading.append(link);
        });

        body.append(fields, skills, reading);
        card.append(summary, body);
        fragment.append(card);
      });

      catalog.replaceChildren(fragment);
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const password = passwordInput.value;
      if (!password || !window.crypto?.subtle) {
        status.textContent = window.crypto?.subtle
          ? "Enter the course password."
          : "This browser cannot decrypt the catalogue. Please use a current browser.";
        return;
      }

      submitButton.disabled = true;
      submitButton.textContent = "Unlocking…";
      status.textContent = "Checking password…";
      let loaded = false;

      try {
        const payload = await loadEncryptedCatalog();
        loaded = true;
        if (
          payload.version !== 1 ||
          payload.kdf !== "PBKDF2" ||
          payload.hash !== "SHA-256" ||
          payload.cipher !== "AES-GCM" ||
          payload.iterations < 100000 ||
          payload.iterations > 1000000
        ) throw new Error("Unsupported catalogue format");

        const keyMaterial = await crypto.subtle.importKey(
          "raw",
          encoder.encode(password),
          "PBKDF2",
          false,
          ["deriveKey"]
        );
        const key = await crypto.subtle.deriveKey(
          {
            name: "PBKDF2",
            salt: fromBase64(payload.salt),
            iterations: payload.iterations,
            hash: payload.hash
          },
          keyMaterial,
          { name: "AES-GCM", length: 256 },
          false,
          ["decrypt"]
        );
        const plaintext = await crypto.subtle.decrypt(
          {
            name: "AES-GCM",
            iv: fromBase64(payload.iv),
            additionalData: encoder.encode(payload.aad)
          },
          key,
          fromBase64(payload.ciphertext)
        );
        const decrypted = JSON.parse(decoder.decode(plaintext)) as { projects?: ProjectCandidate[] };
        if (!Array.isArray(decrypted.projects) || decrypted.projects.length === 0) {
          throw new Error("Invalid catalogue");
        }

        renderCatalog(decrypted.projects);
        passwordInput.value = "";
        lock.hidden = true;
        catalogShell.hidden = false;
        status.textContent = "Catalogue unlocked.";
        requestAnimationFrame(() => catalog.querySelector("summary")?.focus());
      } catch {
        status.textContent = loaded
          ? "That password did not unlock the catalogue. Please try again."
          : "The encrypted catalogue is temporarily unavailable. Please try again.";
        passwordInput.select();
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = "Unlock";
      }
    });

    relockButton.addEventListener("click", () => {
      catalog.replaceChildren();
      catalogShell.hidden = true;
      lock.hidden = false;
      status.textContent = "Password is checked in this browser and is never submitted.";
      requestAnimationFrame(() => passwordInput.focus());
    });
  }
</script>

