---
import BaseLayout from "../layouts/BaseLayout.astro";
import EmailReveal from "../components/EmailReveal.astro";

const nextPhdYear = new Date().getFullYear() + 1;

const paths = [
  {
    label: "Prospective Ph.D. students",
    subject: `[PhD ${nextPhdYear}] Name — research direction — current institution`,
    detail:
      "Apply through the UMD Computer Science graduate admissions process. Individual application reviews and admission decisions are not made by email. A concise research-fit message is optional and does not replace the official application.",
    link: "https://www.cs.umd.edu/grad",
    linkLabel: "UMD graduate admissions"
  },
  {
    label: "Current UMD students",
    subject: "[UMD Research] Name — program/year — research direction",
    detail:
      "Explain the time you can commit during the semester, the preparation you already have, and the specific Furong Lab project or question you hope to explore. Priority goes to students who can make a sustained research commitment."
  },
  {
    label: "Research internships",
    subject: "[Internship] Name — proposed dates — research direction",
    detail:
      "State your exact availability, location or remote constraints, funding status, and the technical contribution you are prepared to make. Generic requests for any available internship are unlikely to receive a response."
  },
  {
    label: "Visiting students or scholars",
    subject: "",
    detail:
      "Furong Lab is not accepting visiting students or visiting scholars at this time. Please do not send visiting-position proposals or requests for invitation, sponsorship, or affiliation."
  },
  {
    label: "High school students",
    subject: "",
    detail:
      "Furong Lab is generally unable to supervise individual high-school projects or informal internships. The Maryland Robotics Center’s SPARC program offers eligible high-school students a structured three-week summer robotics experience. Apply through the program rather than emailing individual lab members.",
    link: "https://robotics.umd.edu/education/student-preparation-advance-robotics-college-sparc-certificate-program",
    linkLabel: "Explore the MRC SPARC program"
  }
];

const directions = [
  {
    number: "01",
    title: "World models",
    prompt: "Learn what can happen",
    detail: "Embodied AI, multimodal learning, and sequential decision-making.",
    href: "/research/#world-models"
  },
  {
    number: "02",
    title: "Reasoning control",
    prompt: "Decide how to think",
    detail: "AI agents, test-time compute, and agentic workflows.",
    href: "/research/#reasoning-control"
  },
  {
    number: "03",
    title: "Trustworthy self-improvement",
    prompt: "Learn from failure",
    detail: "AI safety, alignment, and robust learning.",
    href: "/research/#self-improvement"
  }
];
---

<BaseLayout
  title="Prospective Students — Furong Lab"
  description="How prospective Ph.D. students, UMD students, and internship candidates should contact Furong Lab."
>
  <section class="shell page-hero join-hero">
    <p class="eyebrow">Prospective students</p>
    <h1>Read this before contacting Furong Lab.</h1>
    <p>
      Thoughtful, specific messages are welcome. Mass emails, generic requests, and messages that do not follow the guidance below may not receive a response.
    </p>
  </section>

  <section class="shell section join-section" aria-labelledby="right-path">
    <div class="section-heading">
      <div><p class="eyebrow">Step 1</p><h2 id="right-path">Choose the right path.</h2></div>
      <p>Use the subject-line format for your situation. It lets the lab identify serious, relevant inquiries quickly.</p>
    </div>
    <div class="inquiry-grid">
      {paths.map((path) => (
        <article class="inquiry-card">
          <h3>{path.label}</h3>
          <p>{path.detail}</p>
          {path.subject ? (
            <div class="subject-example">
              <span>Email subject</span>
              <code>{path.subject}</code>
            </div>
          ) : null}
          {path.link ? <a href={path.link}>{path.linkLabel} <span aria-hidden="true">↗</span></a> : null}
        </article>
      ))}
    </div>
  </section>

  <section class="join-directions-band">
    <div class="shell section">
      <div class="section-heading">
        <div><p class="eyebrow">Step 2</p><h2>Choose one research direction.</h2></div>
        <p>Do not write “AI” or “machine learning” as your interest. Name one pillar, then identify a specific project, paper, or research question within it.</p>
      </div>
      <div class="direction-choice-grid">
        {directions.map((direction) => (
          <a class="direction-choice" href={direction.href}>
            <span>{direction.number}</span>
            <div>
              <h3>{direction.title}</h3>
              <strong>{direction.prompt}</strong>
              <p>{direction.detail}</p>
            </div>
            <i aria-hidden="true">↗</i>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="shell section join-message-section">
    <div class="section-heading">
      <div><p class="eyebrow">Step 3</p><h2>Write a message that can be evaluated quickly.</h2></div>
      <p>Keep the message under 200 words. Use links instead of large attachments and include all five items below.</p>
    </div>
    <ol class="message-requirements">
      <li><span>01</span><div><strong>Your request</strong><p>State whether you seek Ph.D. admission, UMD research experience, or a research internship.</p></div></li>
      <li><span>02</span><div><strong>Your research fit</strong><p>Name one Furong Lab pillar and one specific project or paper that genuinely interests you.</p></div></li>
      <li><span>03</span><div><strong>Your proposed contribution</strong><p>Describe one concrete question, experiment, system, or technical direction you could pursue.</p></div></li>
      <li><span>04</span><div><strong>Evidence of preparation</strong><p>Link to your CV, personal page, code, publications, or one substantial technical project. Explain your own contribution.</p></div></li>
      <li><span>05</span><div><strong>Practical constraints</strong><p>Give your dates, weekly availability, location, and funding status when relevant.</p></div></li>
    </ol>
  </section>

  <section class="shell section screening-section" aria-labelledby="after-email">
    <div class="screening-panel">
      <div>
        <p class="eyebrow">What happens next</p>
        <h2 id="after-email">Screen first. Schedule second.</h2>
      </div>
      <div class="screening-copy">
        <p>
          Messages are reviewed for research fit, preparation, and available mentoring capacity. Because of the volume of inquiries, the lab cannot guarantee an individual reply. Please send at most one brief follow-up after two weeks.
        </p>
        <p>
          Candidates who pass the initial review receive a private link for a 15-minute conversation. The booking link is not public and should not be requested or redistributed.
        </p>
        <div class="contact-gate">
          <strong>Ready to contact Furong?</strong>
          <p>Confirm that your subject line and message follow all three steps above, then complete the short human check.</p>
          <EmailReveal inverted />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
